.page--problem_main
.page--problem_category
  .col--checkbox
    width: rem(61px)

  .col--pid
    width: rem(81px)
  
  .col--status
    width: rem(140px)
    position: relative

  .col--difficulty
    width: rem(70px)
    text-align: center
  
  &[lang="en"]
    .col--difficulty
      width: rem(95px)

  .col--ac-tried
    width: rem(100px)
    text-align: center

  +mobile()
    .col--status,
    .col--tried,
    .col--difficulty
      display: none

    .col--ac
      border-left: 0


.widget--category-filter
  &__category
    margin-bottom: rem(6px)

  &__drop
    position: relative
    font-size: rem($font-size-small)
    width: rem(230px)
    padding: rem(10px)
    margin-right: rem(10px)
    background: $menu-drop-bg-color
    box-shadow: $menu-drop-shadow

    &:before
      content: ''
      display: block
      position: absolute
      width: 0
      height: 0
      border: rem($menu-drop-triangle-size) solid transparent
      border-top-color: $menu-drop-bg-color
      border-left-color: $menu-drop-bg-color
      box-shadow: $menu-drop-triangle-shadow
      transform: rotate(135deg)
      transform-origin: 0 0
      pointer-events: none
      left: 100%
      top: 50%
      margin-left: rem(floor($menu-drop-triangle-size * 1.414))

  &__subcategory
    margin: rem(2px)
    display: inline-block
  
  &__tag
    display: inline-block
    padding: rem(5px 6px)

    &:hover
      color: var(--c-accent-fg)
      background: $primary-color
      text-decoration: none

    &.selected
      color: var(--c-accent-fg)
      background: $secondary-color

.drop-target-attached-right .widget--category-filter__drop
  margin-right: 0
  margin-left: rem(10px)

  &:before
    transform-origin: 100% 0
    transform: rotate(-45deg)
    left: auto
    right: 100%
    margin-left: 0
    margin-right: 0
    margin-top: rem(floor($menu-drop-triangle-size * -1.414))


.display-mode .display-mode-hide,
.edit-mode .edit-mode-hide,
.hide-problem-tag .notag--hide,
.tag--hide
  display: none

.hide-problem-tag .tag--hide
  display: block

.toggle-tag
  float: right

// the table sits under the toolbar; rows get room to breathe
.page--problem_main
  .data-table > thead > tr
    height: rem(40px)

  .data-table > tbody > tr
    height: rem(52px)

  .data-table th,
  .data-table td
    padding: rem(0 14px)

.search-container
  padding-bottom: 0

  .title
    margin-bottom: rem(5px)

  .dialog-button
    font-size: rem($font-size-secondary)
    display: inline-block
    padding: rem(5px 6px)
    margin-bottom: rem(5px)

.search-tag__item
  display: inline-block
  padding: rem(5px 6px)
  font-size: rem($font-size-secondary)
  margin-bottom: rem(5px)

  &:hover    
    color: $text-1-color;
    background: var(--c-hover);
    text-decoration: none

  &.selected
    color: var(--c-accent-fg)
    background: $primary-color !important

  &.hide 
    display: none
    opacity: 0    

.category-filter__header
  [data-category-container].list
    overflow-x: auto

  .list
    .list__item
      padding: 12px 12px
      cursor: pointer
      margin: 0px 10px
      background: var(--c-hover)
      min-width: 90px
      text-align: center
      position: relative

      &.selected
        background: $primary-color
        color: var(--c-accent-fg)
        font-weight: bold

    .list__item::first
      margin-left: 0px

.category-filter__body
  margin: 12px 10px 0 10px
  background: var(--c-sunken)
  max-height: rem(400px)
  overflow-y: auto  

  .subcategory-container
    &.hide
      display: none
      opacity: 0

    & h2
      font-size: rem($font-size)
      font-weight: bold
      margin-bottom: 16px

    .divider
      border-bottom: 1px solid $border-2-color
      margin: rem(16px) 0

    .search-tag__item
      background: var(--c-sunken);

// toolbar: search box, problem count, sorter, submit
.search
  width: 100%
  position: relative
  display: flex
  align-items: center
  gap: rem(10px)
  padding: rem(12px 16px)
  background: $section-bg-color
  border-bottom: 1px solid $border-2-color

  [data-fragment-id="problem_stat"]
    order: 2
    flex: 0 0 auto

    p
      margin: 0
      font-size: rem($font-size-small)
      color: $text-3-color
      white-space: nowrap

  .search-sort
    order: 3
    flex: 0 0 auto
    width: rem(124px)
    height: rem(38px)
    padding: 0 rem(8px)
    border: 1px solid $border-1-color
    border-radius: $radius-sm
    background: $section-bg-color
    color: $text-2-color
    font-size: rem($font-size-small)
    outline: 0

    &:focus
      border-color: $input-focus-border-color

.search > input
  order: 1
  flex: 1 1 auto
  min-width: 0
  height: rem(38px)
  border: 1px solid $border-1-color
  border-radius: $radius-sm
  padding: 0 rem(12px)
  background: var(--c-bg)
  outline: none
  color: $text-1-color
  font-size: rem($font-size-secondary)

  &::placeholder
    color: $text-3-color

  &:focus
    border-color: $input-focus-border-color
    background: $section-bg-color

.search > button
  order: 4
  flex: 0 0 auto
  width: rem(38px)
  height: rem(38px)
  border: 1px solid $primary-color
  border-radius: $radius-pill
  background: $primary-color
  text-align: center
  color: var(--c-accent-fg)
  cursor: pointer
  font-size: rem(17px)
  transition: background .15s

  &:hover
    background: var(--c-accent-hover)
    border-color: var(--c-accent-hover)

.page--problem_main
  .col--difficulty
    width: rem(110px)

  .col--ac-tried
    width: rem(120px)
