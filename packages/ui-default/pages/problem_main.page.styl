.page--problem_main
.page--problem_category
  .col--checkbox
    width: rem(61px)

  .col--pid
    width: rem(81px)
  
  .col--status
    width: rem(96px)
    position: relative

  .col--difficulty
    width: rem(84px)
    text-align: right

  &[lang="en"]
    .col--difficulty
      width: rem(95px)

  .col--ac-tried
    width: rem(96px)
    text-align: right

  +mobile()
    .col--status,
    .col--tried,
    .col--difficulty
      display: none

    .col--ac
      text-align: center


.widget--category-filter
  &__category
    margin-bottom: rem(6px)

  &__drop
    position: relative
    font-size: rem($font-size-small)
    width: rem(230px)
    padding: rem(10px)
    margin-right: rem(10px)
    background: $menu-drop-bg-color
    box-shadow: $menu-drop-shadow

    &:before
      content: ''
      display: block
      position: absolute
      width: 0
      height: 0
      border: rem($menu-drop-triangle-size) solid transparent
      border-top-color: $menu-drop-bg-color
      border-left-color: $menu-drop-bg-color
      box-shadow: $menu-drop-triangle-shadow
      transform: rotate(135deg)
      transform-origin: 0 0
      pointer-events: none
      left: 100%
      top: 50%
      margin-left: rem(floor($menu-drop-triangle-size * 1.414))

  &__subcategory
    margin: rem(2px)
    display: inline-block
  
  &__tag
    display: inline-block
    padding: rem(5px 6px)

    &:hover
      color: var(--c-accent-fg)
      background: $primary-color
      text-decoration: none

    &.selected
      color: var(--c-accent-fg)
      background: $secondary-color

.drop-target-attached-right .widget--category-filter__drop
  margin-right: 0
  margin-left: rem(10px)

  &:before
    transform-origin: 100% 0
    transform: rotate(-45deg)
    left: auto
    right: 100%
    margin-left: 0
    margin-right: 0
    margin-top: rem(floor($menu-drop-triangle-size * -1.414))


// 编辑模式与普通模式各自只该看到自己那一组动作。下面的隐藏规则原本与
// theme/claude-foundation 里 `.problem-catalog__sidebar .menu__link { display: block }`
// 权重相同，被后者压住，「进入 / 离开编辑模式」「隐藏 / 取消隐藏选中」这些
// 互斥项就同时挂在侧栏上。这里把选择器收回到 body 上，权重高于菜单项规则。
body.display-mode .display-mode-hide,
body.edit-mode .edit-mode-hide,
.hide-problem-tag .notag--hide,
.tag--hide
  display: none

.hide-problem-tag .tag--hide
  display: block

.toggle-tag
  float: right

.problem-catalog__table .hide-problem-tag .problem__tag
  display: none

// 行高交给单元格内边距决定（components/table），不再写死像素：
// 写死的 40.15px / 54.9px 让表头比数据行高一截，字号一改就错位。

.search-container
  padding-bottom: 0

  .title
    margin-bottom: rem(5px)

  .dialog-button
    font-size: rem($font-size-secondary)
    display: inline-block
    padding: rem(5px 6px)
    margin-bottom: rem(5px)

.search-tag__item
  display: inline-block
  padding: rem(5px 6px)
  font-size: rem($font-size-secondary)
  margin-bottom: rem(5px)

  &:hover    
    color: $text-1-color;
    background: var(--c-hover);
    text-decoration: none

  &.selected
    color: var(--c-accent-fg)
    background: $primary-color !important

  &.hide 
    display: none
    opacity: 0    

.category-filter__header
  [data-category-container].list
    overflow-x: auto

  .list
    .list__item
      padding: 12px 12px
      cursor: pointer
      margin: 0px 10px
      background: var(--c-hover)
      min-width: 90px
      text-align: center
      position: relative

      &.selected
        background: $primary-color
        color: var(--c-accent-fg)
        font-weight: bold

    .list__item::first
      margin-left: 0px

.category-filter__body
  margin: 12px 10px 0 10px
  background: var(--c-sunken)
  max-height: rem(400px)
  overflow-y: auto  

  .subcategory-container
    &.hide
      display: none
      opacity: 0

    & h2
      font-size: rem($font-size)
      font-weight: bold
      margin-bottom: 16px

    .divider
      border-bottom: 1px solid $border-2-color
      margin: rem(16px) 0

    .search-tag__item
      background: var(--c-sunken);

.search
  position: relative
  display: flex
  align-items: center
  gap: 8px
  width: 100%

  // 原来输入框、题数、排序、按钮都靠绝对定位拼在一起：题数和输入框贴死、
  // 按钮右边缘和卡片内边距差 3px。改成一条 flex 行，右端自然落到卡片内边距上。
  > input
    flex: 1 1 auto
    min-width: 0
    height: 38px
    padding: 0 12px
    border: 1px solid var(--c-border-strong)
    border-radius: var(--r-sm)
    background: var(--c-bg)
    color: var(--c-fg)
    font-size: .94rem

  > div
    position: static
    right: auto
    top: auto
    flex: none
    color: var(--c-fg-2)
    font-size: .86rem
    white-space: nowrap

  > button
    position: static
    flex: none
    width: 38px
    height: 38px
    border: 1px solid var(--c-accent)
    border-radius: var(--r-sm)
    background: var(--c-accent)
    color: var(--c-accent-fg)
    font-size: 18px
    cursor: pointer

.search-sort
  position: static
  flex: none
  width: auto
  min-width: 108px
  height: 38px
  border: 1px solid var(--c-border-strong)
  border-radius: var(--r-sm)
  background: var(--c-bg)
  color: var(--c-fg)
  cursor: pointer

// 题库是“扫数据”的页面：表格字号按 14px 起，行高压到能一屏看清更多题，
// 数字列右对齐并用等宽数字，状态列只留一条左线，不再铺一整块浅绿。
.page--problem_main
  .problem-catalog__table .data-table
    font-size: rem($font-size-secondary)

  .problem-catalog__table .data-table th
    padding: rem(10px 12px)
    font-size: .7rem
    letter-spacing: .06em

  .problem-catalog__table .data-table td
    padding: rem(9px 12px)
    line-height: 1.45

  .problem-catalog__table .col--ac-tried,
  .problem-catalog__table .col--difficulty
    color: var(--c-fg-2)
    font-variant-numeric: tabular-nums

  .problem-catalog__table .col--problem-name a
    display: inline-flex
    align-items: baseline
    gap: rem(7px)

  +mobile()
    .problem-catalog__table .col--problem-name
      white-space: normal

    .problem-catalog__table .col--problem-name a
      display: inline

    .problem-catalog__table .col--problem-name b
      margin-right: rem(6px)

  .problem-catalog__table .col--problem-name b
    margin: 0
    color: var(--c-fg-3)
    font-weight: 500
    font-variant-numeric: tabular-nums

  // 状态：一条 2px 的状态线 + 短文案。整行铺色会让表格看起来像被高亮过，
  // 但完全去掉又会让长列表里通过的行失去可扫的锚点，所以保留线、去掉底。
  .problem-catalog__table .record-status--border
    border-left-width: 2px

  .problem-catalog__table .record-status--border.pass
    background: none

  .problem-catalog__table .col--status
    padding-left: rem(14px)

  .problem-catalog__table .col--status__text
    display: inline-flex
    align-items: center
    gap: rem(5px)
    font-size: rem($font-size-small)

// 搜索框与排序在手机上仍然要 16px，否则 iOS 聚焦时会放大整页
+mobile()
  .problem-catalog__search .search > input,
  .problem-catalog__search .search-sort
    font-size: 16px
