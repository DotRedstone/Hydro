.page--homework_detail
  .col--status
    width: rem(150px)

  .col--submit-at
    width: rem(150px)

  .col--problem
    border-left: 1px solid $table-border-color

  +mobile()
    .col--submit-at
      display: none

  .homework-detail-layout .learning-activity-description > .section__header .section__title
    font-size: 1.35rem
    line-height: 1.4

  .homework-detail-layout .learning-activity-problems .section__header
    padding: 20px 26px

  .homework-detail-layout .learning-activity-problems .section__title
    font-size: 1.17rem
    font-weight: 640

  .homework-detail-layout .learning-activity-problems .section__body.no-padding
    padding: 0

  .homework-detail-layout .learning-activity-problems .col--problem
    min-width: 240px

  .homework-detail-layout .learning-activity-problems .col--problem-name a
    color: var(--c-fg)
    font-weight: 570

  .homework-detail-layout .learning-activity-problems .col--problem-name a:hover
    color: var(--c-link)

  .homework-detail-layout .learning-activity-problems .data-table td
    padding: 13px 12px
    line-height: 1.6

  .homework-detail-layout .learning-activity-side .section
    margin-bottom: var(--sp-5)

  @media only screen and (max-width: 600px)
    .homework-detail-layout .learning-activity-problems .section__header
      padding: 17px 18px
