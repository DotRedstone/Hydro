// Homepage uses configured contents and existing partials; visual hierarchy only.
.page--homepage
  // 首页不再是“品牌展示页”：没有大标题、宣传语和重复导航，
  // 模块从顶部开始，第一条就是真实内容。
  .learning-hub__columns
    display: flex
    align-items: flex-start
    flex-wrap: wrap

  .learning-hub__columns::before,
  .learning-hub__columns::after
    content: none

  .learning-hub__column
    float: none
    min-width: 0

  .learning-hub__module
    margin-bottom: 18px

  .learning-hub__module > .section
    margin: 0

  .learning-hub__module .section__header
    padding: 13px 18px

  // 右侧“所有比赛 →”原本绝对定位到表头右上角，和收窄后的内边距对不齐；
  // 表头本身已经是 flex，放回文档流靠右就行
  .learning-hub__module .section__tools
    position: static
    display: flex
    align-items: center
    margin-left: auto
    font-size: .82rem

  .learning-hub__module .section__tools .link
    color: var(--c-fg-3)

  .learning-hub__module .section__tools .link:hover
    color: var(--c-link)

  .learning-hub__module .section__title
    margin: 0
    font-size: 1rem
    line-height: 1.45
    font-weight: 600
    letter-spacing: -.005em

  .learning-hub__module .section__body
    padding: 16px 18px

  .learning-hub__module .section__body.no-padding
    padding: 0

  // 公告是“读一段话”，不该占一块面板：去掉卡片和阴影，只留一条分隔线，
  // 让它读起来像页面顶部的一则通知，而不是又一个内容块
  .learning-hub__module--bulletin > .section
    background: transparent
    border: 0
    border-bottom: 1px solid var(--c-border)
    border-radius: 0
    box-shadow: none

  .learning-hub__module--bulletin .section__body
    padding: 2px 2px 16px
    color: var(--c-fg-2)
    font-size: .95rem
    line-height: 1.8
    overflow-wrap: anywhere

  // 一言由前端异步填充；接口没返回内容时卡片就是一块空白面板，
  // 与其留一张空卡片，不如等它真的有句子再出现
  .learning-hub__module--hitokoto .section:has(.section__body:empty)
    display: none

  .learning-hub__module--bulletin .typo > :first-child
    margin-top: 0

  .learning-hub__module--bulletin .typo h1,
  .learning-hub__module--bulletin .typo h2
    color: var(--c-fg)
    line-height: 1.4

  .learning-hub__module--bulletin .typo p,
  .learning-hub__module--bulletin .typo li
    line-height: 1.85

  .learning-hub__module .section__list
    margin: 0
    padding: 0
    list-style: none

  .learning-hub__module .section__list__item
    padding: 12px 18px
    border-bottom: 1px solid var(--c-border)

  .learning-hub__module .section__list__item:last-child
    border-bottom: 0

  .learning-hub__module .section__list__item .media__body
    min-width: 0

  // 首页列表里的训练简介再收一档，避免一条训练占掉半个模块
  .learning-hub__module .training__intro
    margin: 2px 0 0
    color: var(--c-fg-3)
    font-size: .82rem
    line-height: 1.6

  .learning-hub__module .training__intro p
    margin: 0

  .learning-hub__module--problem_search form .section__body
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 10px

  .learning-hub__module--problem_search label
    min-width: 140px
    flex: 1 1 140px
    margin: 0

  .learning-hub__module--problem_search input
    width: 100%
    min-height: 42px

  .learning-hub__module--problem_search button
    min-height: 42px

  .learning-hub__module--recent_problems .section__body p,
  .learning-hub__module--starred_problems .section__body p
    margin: 0
    padding: 9px 0
    border-bottom: 1px solid var(--c-border)
    font-size: .9rem
    line-height: 1.55

  .learning-hub__module--recent_problems .section__body p:last-child,
  .learning-hub__module--starred_problems .section__body p:last-child
    border-bottom: 0

  .learning-hub__module--ranking .data-table
    font-size: .84rem

  .learning-hub__module .pager
    padding: 10px 17px

  @media only screen and (max-width: 900px)
    .learning-hub__column
      width: 100%

  @media only screen and (max-width: 600px)
    .learning-hub__module--bulletin .section__body
      padding: 20px 18px

    .learning-hub__module .section__list__item
      padding: 15px 16px

  // Rail lists: one row per item, hairline separated, meta pushed to the right.
  .home-list__row
    display: flex
    align-items: baseline
    gap: 12px
    padding: 8px 18px
    border-bottom: 1px solid token-alpha(var(--c-border), 55%)

    &:last-child
      border-bottom: 0

    &:hover
      background: var(--c-hover)

  .home-list__title
    flex: 1 1 auto
    min-width: 0
    font-size: .95rem

    b
      margin-right: 2px
      color: var(--c-fg-3)
      font-weight: 500
      font-variant-numeric: tabular-nums

  .home-list__meta
    flex: 0 0 auto
    color: var(--c-fg-3)
    font-size: .82rem
    white-space: nowrap
