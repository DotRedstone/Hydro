// Homepage uses configured contents and existing partials; visual hierarchy only.
.page--homepage
  .learning-hub__intro
    margin: 0 0 30px
    padding: 30px 32px
    border: 1px solid var(--claude-line)
    border-radius: var(--claude-radius-lg)
    background: var(--claude-surface)
    box-shadow: var(--claude-shadow)

  .learning-hub__eyebrow
    margin: 0 0 5px
    color: var(--claude-accent)
    font-size: .79rem
    font-weight: 650
    line-height: 1.4
    letter-spacing: .08em

  .learning-hub__intro h1
    margin: 0 0 22px
    color: var(--claude-ink)
    font-size: clamp(1.75rem, 3vw, 2.35rem)
    line-height: 1.3
    letter-spacing: -.03em
    font-weight: 650

  .learning-hub__shortcuts
    display: flex
    flex-wrap: wrap
    gap: 10px

  .learning-hub__shortcuts a
    display: inline-flex
    align-items: center
    justify-content: center
    min-height: 42px
    padding: 9px 15px
    border: 1px solid var(--claude-line)
    border-radius: var(--claude-radius-sm)
    background: var(--claude-page)
    color: var(--claude-ink)
    font-size: .9rem
    font-weight: 550
    text-decoration: none

  .learning-hub__shortcuts a:hover
    border-color: var(--claude-accent)
    background: var(--claude-accent-soft)
    color: var(--claude-accent)

  .learning-hub__columns
    display: flex
    align-items: flex-start
    flex-wrap: wrap

  .learning-hub__columns::before,
  .learning-hub__columns::after
    content: none

  .learning-hub__column
    float: none
    min-width: 0

  .learning-hub__module
    margin-bottom: 22px

  .learning-hub__module > .section
    margin: 0

  .learning-hub__module .section__header
    padding: 18px 22px

  .learning-hub__module .section__title
    margin: 0
    font-size: 1.07rem
    line-height: 1.45
    font-weight: 650
    letter-spacing: -.01em

  .learning-hub__module .section__body
    padding: 19px 22px

  .learning-hub__module .section__body.no-padding
    padding: 0

  .learning-hub__module--bulletin .section__body
    padding: 26px 30px
    font-size: 1rem
    line-height: 1.85
    overflow-wrap: anywhere

  .learning-hub__module--bulletin .typo > :first-child
    margin-top: 0

  .learning-hub__module--bulletin .typo h1,
  .learning-hub__module--bulletin .typo h2
    color: var(--claude-ink)
    line-height: 1.4

  .learning-hub__module--bulletin .typo p,
  .learning-hub__module--bulletin .typo li
    line-height: 1.85

  .learning-hub__module .section__list
    margin: 0
    padding: 0
    list-style: none

  .learning-hub__module .section__list__item
    padding: 17px 21px
    border-bottom: 1px solid var(--claude-line)

  .learning-hub__module .section__list__item:last-child
    border-bottom: 0

  .learning-hub__module .section__list__item .media__body
    min-width: 0

  .learning-hub__module .contest__title,
  .learning-hub__module .training__title,
  .learning-hub__module .homework__title
    margin: 0 0 7px
    font-size: 1.03rem
    line-height: 1.5
    font-weight: 600

  .learning-hub__module .contest__title a,
  .learning-hub__module .training__title a,
  .learning-hub__module .homework__title a
    color: var(--claude-ink)

  .learning-hub__module .contest__title a:hover,
  .learning-hub__module .training__title a:hover,
  .learning-hub__module .homework__title a:hover
    color: var(--claude-accent)

  .learning-hub__module .supplementary.list
    display: flex
    flex-wrap: wrap
    gap: 6px 13px
    margin: 9px 0 0
    font-size: .81rem
    line-height: 1.6
    color: var(--claude-ink-muted)

  .learning-hub__module .numbox
    display: flex
    flex-direction: column
    justify-content: center
    width: 64px
    min-height: 64px
    padding: 7px
    border: 1px solid var(--claude-line)
    border-radius: var(--claude-radius-md)
    background: var(--claude-page)
    color: var(--claude-ink)

  .learning-hub__module .numbox__num
    font-size: 1.3rem
    line-height: 1.2
    font-weight: 650

  .learning-hub__module .numbox__text
    color: var(--claude-ink-muted)
    font-size: .75rem

  .learning-hub__module--problem_search form .section__body
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 10px

  .learning-hub__module--problem_search label
    min-width: 140px
    flex: 1 1 140px
    margin: 0

  .learning-hub__module--problem_search input
    width: 100%
    min-height: 42px

  .learning-hub__module--problem_search button
    min-height: 42px

  .learning-hub__module--recent_problems .section__body p,
  .learning-hub__module--starred_problems .section__body p
    margin: 0
    padding: 9px 0
    border-bottom: 1px solid var(--claude-line)
    font-size: .9rem
    line-height: 1.55

  .learning-hub__module--recent_problems .section__body p:last-child,
  .learning-hub__module--starred_problems .section__body p:last-child
    border-bottom: 0

  .learning-hub__module--ranking .data-table
    font-size: .84rem

  .learning-hub__module .pager
    padding: 10px 17px

  @media only screen and (max-width: 900px)
    .learning-hub__column
      width: 100%

  @media only screen and (max-width: 600px)
    .learning-hub__intro
      padding: 21px 18px
      margin-bottom: 20px

    .learning-hub__module--bulletin .section__body
      padding: 20px 18px

    .learning-hub__module .section__list__item
      padding: 15px 16px
