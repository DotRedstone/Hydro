// Homepage uses configured contents and existing partials; visual hierarchy only.
.page--homepage
  .learning-hub__intro
    margin: 0 0 26px
    padding: 0 0 20px
    border: 0
    border-bottom: 1px solid token-alpha(var(--c-border), 70%)
    background: transparent

  .learning-hub__eyebrow
    margin: 0 0 6px
    color: var(--c-fg-3)
    font-size: .74rem
    font-weight: 600
    letter-spacing: .12em
    text-transform: uppercase
    line-height: 1.4
    letter-spacing: .08em

  .learning-hub__intro h1
    margin: 0 0 16px
    color: var(--c-heading)
    font-family: var(--font-display)
    font-size: clamp(1.9rem, 3.2vw, 2.5rem)
    line-height: 1.2
    letter-spacing: -.02em
    font-weight: 500

  .learning-hub__shortcuts
    display: flex
    flex-wrap: wrap
    gap: 10px

  .learning-hub__lead
    margin: 0 0 14px
    max-width: 46ch
    color: var(--c-fg-2)
    font-size: .96rem
    line-height: 1.65

  .learning-hub__cta
    margin: 4px 0 16px

  .learning-hub__shortcuts
    gap: 20px

  .learning-hub__shortcuts a
    display: inline-flex
    align-items: center
    min-height: 24px
    padding: 0
    border: 0
    background: none
    color: var(--c-fg-2)
    font-size: .92rem
    font-weight: 500
    text-decoration: none
    border-bottom: 1px solid transparent

  .learning-hub__shortcuts a:hover
    color: var(--c-link)
    border-bottom-color: var(--c-link)

  .learning-hub__columns
    display: flex
    align-items: flex-start
    flex-wrap: wrap

  .learning-hub__columns::before,
  .learning-hub__columns::after
    content: none

  .learning-hub__column
    float: none
    min-width: 0

  .learning-hub__module
    margin-bottom: 22px

  .learning-hub__module > .section
    margin: 0

  .learning-hub__module .section__header
    padding: 18px 22px

  .learning-hub__module .section__title
    margin: 0
    font-size: 1.07rem
    line-height: 1.45
    font-weight: 650
    letter-spacing: -.01em

  .learning-hub__module .section__body
    padding: 19px 22px

  .learning-hub__module .section__body.no-padding
    padding: 0

  .learning-hub__module--bulletin .section__body
    padding: 26px 30px
    font-size: 1rem
    line-height: 1.85
    overflow-wrap: anywhere

  .learning-hub__module--bulletin .typo > :first-child
    margin-top: 0

  .learning-hub__module--bulletin .typo h1,
  .learning-hub__module--bulletin .typo h2
    color: var(--c-fg)
    line-height: 1.4

  .learning-hub__module--bulletin .typo p,
  .learning-hub__module--bulletin .typo li
    line-height: 1.85

  .learning-hub__module .section__list
    margin: 0
    padding: 0
    list-style: none

  .learning-hub__module .section__list__item
    padding: 17px 21px
    border-bottom: 1px solid var(--c-border)

  .learning-hub__module .section__list__item:last-child
    border-bottom: 0

  .learning-hub__module .section__list__item .media__body
    min-width: 0

  .learning-hub__module .contest__title,
  .learning-hub__module .training__title,
  .learning-hub__module .homework__title
    margin: 0 0 7px
    font-size: 1.03rem
    line-height: 1.5
    font-weight: 600

  .learning-hub__module .contest__title a,
  .learning-hub__module .training__title a,
  .learning-hub__module .homework__title a
    color: var(--c-fg)

  .learning-hub__module .contest__title a:hover,
  .learning-hub__module .training__title a:hover,
  .learning-hub__module .homework__title a:hover
    color: var(--c-link)

  .learning-hub__module .supplementary.list
    display: flex
    flex-wrap: wrap
    gap: 6px 13px
    margin: 9px 0 0
    font-size: .81rem
    line-height: 1.6
    color: var(--c-fg-2)

  .learning-hub__module .numbox
    display: flex
    flex-direction: column
    justify-content: center
    width: 64px
    min-height: 64px
    padding: 7px
    border: 1px solid var(--c-border)
    border-radius: var(--r)
    background: var(--c-bg)
    color: var(--c-fg)

  .learning-hub__module .numbox__num
    font-size: 1.3rem
    line-height: 1.2
    font-weight: 650

  .learning-hub__module .numbox__text
    color: var(--c-fg-2)
    font-size: .75rem

  .learning-hub__module--problem_search form .section__body
    display: flex
    align-items: center
    flex-wrap: wrap
    gap: 10px

  .learning-hub__module--problem_search label
    min-width: 140px
    flex: 1 1 140px
    margin: 0

  .learning-hub__module--problem_search input
    width: 100%
    min-height: 42px

  .learning-hub__module--problem_search button
    min-height: 42px

  .learning-hub__module--recent_problems .section__body p,
  .learning-hub__module--starred_problems .section__body p
    margin: 0
    padding: 9px 0
    border-bottom: 1px solid var(--c-border)
    font-size: .9rem
    line-height: 1.55

  .learning-hub__module--recent_problems .section__body p:last-child,
  .learning-hub__module--starred_problems .section__body p:last-child
    border-bottom: 0

  .learning-hub__module--ranking .data-table
    font-size: .84rem

  .learning-hub__module .pager
    padding: 10px 17px

  @media only screen and (max-width: 900px)
    .learning-hub__column
      width: 100%

  @media only screen and (max-width: 600px)
    .learning-hub__intro
      padding: 21px 18px
      margin-bottom: 20px

    .learning-hub__module--bulletin .section__body
      padding: 20px 18px

    .learning-hub__module .section__list__item
      padding: 15px 16px
