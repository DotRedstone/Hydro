.page--record_main
  .col--status
    width: rem(170px)
    position: relative

  .col--submit-at
    width: rem(115px)
    text-align: center

  &.nojs .col--submit-at
    width: rem(160px)

  .col--submit-by
    width: rem(140px)
    text-align: right

  .col--time, .col--memory, .col--lang
    width: rem(95px)
    text-align: center

  .col--status, .col--submit-by, .col--lang
    border-right: 1px solid $table-border-color

  .col--status__text
    position: relative
    z-index: 2

  .col--status__progress-container
    position: absolute
    left: 0
    top: 0
    width: 100%
    height: 100%
    z-index: 1

  .col--status__progress
    position: absolute
    left: 0
    top: 0
    height: 100%
    background: #fff6d1

  +tablet()
    .col--time,
    .col--memory,
    .col--lang
      display: none

  +mobile()
    .col--submit-by,
    .col--submit-at,
    .col--time,
    .col--memory,
    .col--lang
      display: none

  .record-main-layout
    margin-left: auto
    margin-right: auto

  .record-filter-card
    overflow: hidden
    margin-bottom: var(--claude-space-5)

  .record-list-card
    margin-bottom: var(--claude-space-5)

  .record-filter-card .section__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 16px
    padding: 18px 24px

  .record-filter-card .section__title
    font-size: 1.15rem
    line-height: 1.4

  .record-filter-card .section__body
    padding: 22px 24px

  .record-filter-grid::before,
  .record-filter-grid::after
    content: none

  .record-filter-grid
    display: grid
    grid-template-columns: repeat(5, minmax(0, 1fr))
    gap: 16px
    margin: 0

  .record-filter-grid > .columns
    width: auto
    min-width: 0
    padding: 0

  .record-filter-grid label
    display: block
    color: var(--claude-ink-muted)
    font-size: .84rem
    font-weight: 600
    line-height: 1.45

  .record-filter-grid input,
  .record-filter-grid select
    width: 100%
    min-width: 0
    height: 42px
    margin-top: 7px
    padding: 8px 11px
    border: 1px solid var(--claude-line)
    border-radius: var(--claude-radius-sm)
    background: var(--claude-page)
    color: var(--claude-ink)
    font-size: .9rem

  .record-filter-card .section__tools
    display: flex
    gap: 8px
    flex-wrap: wrap

  .record-filter-card .section__tools .button
    min-height: 38px
    padding: 8px 14px
    font-size: .86rem

  .record-list-body
    padding: 0

  .record_main__table
    min-width: 900px
    width: 100%
    font-size: .9rem

  .record_main__table thead th
    padding: 15px 13px
    font-size: .78rem
    letter-spacing: .035em
    text-transform: uppercase
    white-space: nowrap

  .record_main__table tbody td
    padding: 14px 13px
    line-height: 1.55
    vertical-align: middle

  .record_main__table tbody tr
    transition: background .15s ease

  .record_main__table .col--problem
    min-width: 240px
    white-space: normal
    line-height: 1.5

  .record_main__table .col--submit-by
    text-align: left

  .record_main__table .col--submit-at
    white-space: nowrap

  .record_main__table .col--status
    min-width: 150px

  .record_main__table .col--status__progress
    background: rgba(201, 100, 66, .12)

  @media only screen and (max-width: 900px)
    .record-filter-grid
      grid-template-columns: repeat(2, minmax(0, 1fr))

  @media only screen and (max-width: 600px)
    .record-filter-card .section__header
      align-items: flex-start
      flex-direction: column
      padding: 16px 18px

    .record-filter-card .section__body
      padding: 18px

    .record-filter-grid
      grid-template-columns: minmax(0, 1fr)
      gap: 13px

    .record-filter-card .section__tools
      width: 100%
