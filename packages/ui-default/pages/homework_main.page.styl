// 作业列表。
//
// 行本身的样式（日期、标题、元信息、悬停）统一在 theme/claude-foundation.styl 的
// .activity-* 规则里，和比赛、训练列表共用一套；这里只处理本页的工具条。

$highlight-button-color = var(--c-warn)

.page--homework_main
  .homework-list-layout .learning-activity-list-card
    margin-bottom: var(--sp-5)

  // 工具条：搜索 / 分组 / 视图 / 创建共用一行同高的控件
  .homework-list-layout .learning-activity-list-card .section__header
    display: flex
    flex-wrap: wrap
    align-items: center
    justify-content: space-between
    gap: 12px
    padding: 14px 20px

  .homework-list-layout .learning-activity-list-card .section__title
    font-size: 1.06rem
    font-weight: 600
    letter-spacing: -.005em

  .homework-toolbar
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px 10px

  .homework-toolbar > *
    flex: 0 0 auto

  .homework-toolbar .filter-form
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px
    margin: 0

  .homework-toolbar__view
    display: inline-flex
    align-items: center
    gap: 6px
    white-space: nowrap

  .homework-toolbar__label
    color: var(--c-fg-3)
    font-size: .8rem
    white-space: nowrap

  .homework-toolbar [name="q"],
  .homework-toolbar select,
  .homework-toolbar .button
    height: 32px
    min-height: 32px
    margin: 0
    font-size: .85rem

  .homework-toolbar [name="q"]
    width: 200px
    padding: 0 10px

  .homework-toolbar select
    // 右侧要给 form/select 画的下拉箭头留位置
    padding-right: rem(28px)

  .homework-toolbar .button
    padding-left: 12px
    padding-right: 12px

  .homework-list-layout .homework__list
    margin: 0
    padding: 0
    list-style: none

  .homework-list-layout [name="calendar_entry"]
    padding: 20px
    border-top: 1px solid var(--c-border)

  @media only screen and (max-width: 600px)
    .homework-list-layout .learning-activity-list-card .section__header
      padding: 14px 16px

    .homework-toolbar [name="q"]
      width: auto
      flex: 1 1 140px
      min-width: 0

    .homework-toolbar__label
      display: none
