.page--problem_detail,
.page--contest_detail_problem,
.page--homework_detail_problem
  .section__tab-header
    padding-top: 0;
  
  .section__tab-container  + .section__body
    padding-top: 0
  
  .section__tab-header-item
    border-top: 3px solid transparent;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    margin-right: 0;
    color: #182026 !important;
    text-decoration: none;

    &:hover
      border-color: #5f9fd6;
      background: #f8f8f8;
    
    &.tab--active
      border-color: #ed5f82;

  .problem-detail-layout
    display: grid
    grid-template-columns: minmax(0, 1fr) 296px
    gap: var(--claude-space-5)
    align-items: start
    margin-left: auto
    margin-right: auto

  .problem-detail-layout > .columns
    width: auto
    min-width: 0
    float: none
    padding-left: 0
    padding-right: 0

  .problem-detail-main > .section
    margin-bottom: var(--claude-space-5)
    overflow: hidden

  .problem-detail-main > .section:first-child > .section__header
    padding: 24px 28px 18px

  .problem-detail-main > .section:first-child .section__title
    font-size: clamp(1.35rem, 2.2vw, 1.85rem)
    line-height: 1.35
    letter-spacing: -.02em

  .problem-detail-main .problem__tags
    display: flex
    flex-wrap: wrap
    gap: 8px
    margin: 0
    padding: 0
    list-style: none

  .problem-detail-main .problem__tag-item
    display: inline-flex
    align-items: center
    min-height: 30px
    margin: 0
    padding: 5px 10px
    font-size: .82rem
    line-height: 1.35

  .problem-statement-section .section__header
    padding: 18px 28px

  .problem-statement-section .section__title
    font-size: 1.12rem
    line-height: 1.45

  .problem-statement-section .section__body
    padding: 28px clamp(20px, 3vw, 36px)
  
  .problem-statement-section .typo
    color: var(--claude-ink)
    font-size: 1rem
    line-height: 1.85
    overflow-wrap: anywhere

  .problem-statement-section .typo > :first-child
    margin-top: 0

  .problem-statement-section .typo h2
    margin: 1.8em 0 .7em
    font-size: 1.25rem
    line-height: 1.4
    font-weight: 650
    color: var(--claude-ink)

  .problem-statement-section .typo h3
    margin: 1.5em 0 .6em
    font-size: 1.08rem
    line-height: 1.45
    font-weight: 650

  .problem-statement-section .typo p,
  .problem-statement-section .typo li
    line-height: 1.85

  .problem-statement-section .typo pre
    padding: 16px 18px
    border: 1px solid var(--claude-line)
    border-radius: var(--claude-radius-md)
    background: var(--claude-surface-muted)
    line-height: 1.65
    overflow-x: auto

  .problem-statement-section .typo table
    width: 100%
    border-collapse: collapse

  .problem-statement-section .typo th,
  .problem-statement-section .typo td
    padding: 9px 12px
    border: 1px solid var(--claude-line)

  .problem-detail-sidebar
    position: relative

  .problem-detail-sidebar .section--problem-sidebar
    overflow: hidden
    margin-bottom: var(--claude-space-4)

  .problem-detail-sidebar .menu__link
    min-height: 42px
    display: flex
    align-items: center
    padding: 10px 16px
    color: var(--claude-ink-muted)
    font-size: .92rem

  .problem-detail-sidebar .menu__link:hover,
  .problem-detail-sidebar .menu__link.active
    color: var(--claude-accent)
    background: var(--claude-accent-soft)

  .problem-detail-sidebar .menu__seperator
    margin: 8px 16px
    border-color: var(--claude-line)

  .problem-detail-main .section__tab-header
    padding: 0 22px
    border-bottom: 1px solid var(--claude-line)

  .problem-detail-main .section__tab-header-item
    padding: 12px 14px
    border-top: 0
    border-bottom: 2px solid transparent
    color: var(--claude-ink-muted)
    font-size: .9rem
    font-weight: 550

  .problem-detail-main .section__tab-header-item:hover
    color: var(--claude-accent)
    background: var(--claude-surface-muted)

  .problem-detail-main .section__tab-header-item.tab--active
    border-bottom-color: var(--claude-accent)
    color: var(--claude-accent)
    background: transparent

  @media only screen and (max-width: 900px)
    .problem-detail-layout
      grid-template-columns: minmax(0, 1fr)
      gap: var(--claude-space-4)

    .problem-detail-sidebar
      order: 2

  @media only screen and (max-width: 600px)
    .problem-detail-main > .section:first-child > .section__header
      padding: 18px 18px 14px

    .problem-statement-section .section__body
      padding: 20px 18px

    .problem-detail-main .problem__tags
      gap: 6px
