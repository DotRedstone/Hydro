$highlight-button-color = var(--c-warn)

.page--contest_main
  .contest__title
    font-size: rem($font-size-title)
    line-height: 1.2em
    margin-bottom: rem(10px)

  .contest__date
    margin-right: rem(10px)
    white-space: nowrap
    width: rem(60px)

  .contest__info-attended
    color: $success-color

  .contest__item
    border-left: rem(5px) solid transparent
    padding-left: rem(5px)
    
    &.live
      border-left: rem(5px) solid var(--c-bad)

    &.ready
      border-left: rem(5px) solid var(--c-info)

  .section--contest
    &.live
      background: var(--c-bad)

    &.ready
      background: var(--c-info)

    .status_title
      display: inline-block
      font-size: rem($font-size-secondary)
      color: var(--c-accent-fg)
      background: var(--c-overlay)
      padding: rem(7px 10px)
      border-radius: var(--r-xs)

    h1
      line-height: 1.2
      font-size: rem(25px)
      margin: rem(20px 0)

    .info
      color: var(--c-accent-fg)
      font-size: rem($font-size-secondary)

      .icon
        color: var(--c-warn)
        font-size: rem($font-size-icon)

      li
        display: inline-block
        margin-right: rem(10px)

    .attandance
      margin-top: rem(15px)
      font-size: rem($font-size-secondary)
      opacity: 0.8

    .detail-button
      cursor: pointer
      display: block
      text-align: center
      background: $highlight-button-color
      color: var(--c-heading)
      line-height: rem(40px)
      border-radius: var(--r-pill)
      width: rem(150px)
      position: relative
      overflow: hidden
      transition: box-shadow .4s, background-color .4s
      transition-timing-function: ease-out-cubic

      &:after
        position: absolute
        background: var(--c-inverse-fg)
        content: ""
        height: rem(100px)
        left: rem(-70px)
        top: rem(-25px)
        width: rem(50px)
        opacity: 0.2
        transform: rotate(35deg)
        transition: left 0.6s ease-out-cubic
        z-index: 1

      &:hover
        text-decoration: none
        box-shadow: 0 2px 20px token-alpha($highlight-button-color, 45%)
        background: token-tint($highlight-button-color, 80%)

        &:after
          left: 150%

    +mobile()
      .media, .media_body, .media__right
        display: block
        padding: 0

      .media__right .section__body
        padding-top: 0

      .detail-button
        width: auto

.page--contest_problemlist
  .col--status, .col--correction
    width: rem(150px)

  .col--submit-at
    width: rem(130px)
    text-align: center

  &.nojs .col--submit-at
    width: rem(160px)

  .col--score
    width: rem(80px)
    text-align: center;

  .col--problem
    border-left: 1px solid $table-border-color

  +mobile()
    .col--submit-at, .col--correction
      display: none

  +tablet()
    .col--time,
    .col--memory,
    .col--lang
      display: none

  +mobile()
    .col--time,
    .col--memory,
    .col--submit-at,
    .col--lang
      display: none
  
  .col--submit-by
    display: none

  .record_main__table
    .col--status
      width: rem(170px)

    .col--time, .col--memory, .col--lang
      width: rem(95px)
      text-align: center

    .col--lang
      border-right: 0


.page--contest_scoreboard
  .main
    .row
      max-width: 100vw !important;

  .data-table td
    line-height: 1.5

  .col--rank
    width: rem(60px)
    text-align: center
    border-right: 0

  .col--user
    min-width: rem(150px)

  .col--solved, .col--time
    width: rem(70px)
    text-align: center

  .col--total_score
    width: rem(100px)
    text-align: center

  .col--problem
    width: rem(100px)
    border-left: 1px solid $table-border-color
    text-align: center

  .scoreboard--acm
    .col--problem
      width: rem(70px) !important

  +mobile()
    .col--user
      width: auto

    .col--problem
      display: none

  .star-highlight
    background: var(--c-accent-soft)

.page--contest_user
  .col--uid
    width: rem(100px)

.page--contest_balloon
  .col--bid
    width: rem(100px)
  
  .col--status
    width: rem(100px)

  .col--problem
    width: rem(150px)

  .col--awards
    width: rem(130px)

.page--contest_manage
  .col--id
    width: rem(80px)
  .col--score
    width: rem(80px)

/* Phase 3 contest list, details, task path and shared scoreboard (homework included). */
.page--contest_main
  .learning-activity-feature
    overflow: hidden
    border: 1px solid var(--c-border)
    box-shadow: var(--shadow-card)

  .learning-activity-feature .media
    display: flex
    align-items: stretch
    gap: 12px

  .learning-activity-feature .media__body
    min-width: 0
    flex: 1 1 auto

  .learning-activity-feature .media__right
    flex: 0 0 auto

  .learning-activity-feature .section__body
    padding: 24px

  .learning-activity-feature h1
    font-size: clamp(1.35rem, 2vw, 1.75rem)
    line-height: 1.35
    margin: 13px 0

  .learning-activity-feature .info
    display: flex
    flex-wrap: wrap
    gap: 9px 15px
    margin: 15px 0 0
    line-height: 1.65

  .learning-activity-feature .info li
    margin: 0

  .learning-activity-feature .status_title
    font-weight: 600
    border-radius: var(--r-pill)
    padding: 6px 12px

  .learning-activity-feature .detail-button
    min-width: 140px
    width: auto
    padding: 0 16px
    border-radius: var(--r-sm)
    font-size: .91rem
    font-weight: 650

  .learning-activity-list-card .contest__title
    font-size: 1.12rem
    line-height: 1.45
    margin: 0

  .learning-activity-list-card .contest__date
    margin-right: 16px

  .contest__item.live
    border-left-color: var(--c-bad)

  .contest__item.ready
    border-left-color: var(--c-info)

.page--contest_detail
  .contest-detail-layout .learning-activity-description
    margin-top: 0

.page--contest_problemlist
  .contest-problems-layout .learning-activity-main .section
    margin-bottom: var(--sp-5)

  .contest-problems-layout .section__body.no-padding
    padding: 0

  .contest-problems-layout .data-table .col--problem-name
    min-width: 260px
    white-space: normal

  .contest-problems-layout .data-table .col--problem-name a
    font-size: .95rem
    line-height: 1.5
    color: var(--c-fg)

  .contest-problems-layout .data-table .col--problem-name a:hover
    color: var(--c-link)

  .contest-problems-layout .section--clarifications .section__body
    padding: 22px 26px

  .contest-problems-layout .dczcomments__item
    padding: 15px 0
    border-bottom: 1px solid var(--c-border)

  .contest-problems-layout .dczcomments__supplementary
    font-size: .82rem
    line-height: 1.6
    color: var(--c-fg-2)

.page--contest_scoreboard,
.page--homework_scoreboard
  .learning-scoreboard-layout
    margin-left: auto
    margin-right: auto

  .learning-scoreboard-card
    border-radius: var(--r-lg)
    box-shadow: var(--shadow-card)

  .learning-scoreboard-card > .section__header
    display: flex
    flex-direction: column
    align-items: stretch
    gap: 18px
    padding: 24px 28px
    border-bottom: 1px solid var(--c-border)

  .scoreboard-heading
    display: flex
    flex-wrap: wrap
    justify-content: space-between
    align-items: flex-start
    gap: 16px

  .scoreboard-heading__identity
    min-width: 200px
    flex: 1 1 260px

  .scoreboard-heading__eyebrow
    margin: 0 0 6px
    color: var(--c-link)
    font-size: .78rem
    font-weight: 650
    letter-spacing: .08em

  .scoreboard-heading .section__title
    margin: 0
    font-size: clamp(1.4rem, 2.2vw, 1.9rem)
    line-height: 1.35
    font-weight: 650

  .scoreboard-heading__actions
    display: flex
    flex-wrap: wrap
    align-items: center
    justify-content: flex-end
    gap: 7px
    flex: 1 1 270px

  .scoreboard-heading__actions .button
    min-height: 36px
    padding: 7px 11px
    border: 1px solid var(--c-border)
    background: var(--c-sunken)
    color: var(--c-fg-2)
    font-size: .82rem
    white-space: nowrap

  .scoreboard-heading__actions .button:hover
    border-color: var(--c-link)
    color: var(--c-link)

  .learning-scoreboard-card > .section__header .section__tools
    display: flex
    justify-content: flex-end

  .learning-scoreboard-card .select.filter
    min-width: 170px
    min-height: 40px
    padding: 8px 12px
    border-radius: var(--r-sm)

  .learning-scoreboard-card [data-fragment-id="scoreboard"]
    min-width: 0

  .learning-scoreboard-card .section__table-container
    overflow-x: auto

  .learning-scoreboard-card .data-table
    font-size: .88rem

  .learning-scoreboard-card .data-table td
    padding: 12px 11px
    line-height: 1.6

  .learning-scoreboard-card .data-table th
    padding: 14px 11px
    line-height: 1.5

  .learning-scoreboard-card .col--rank
    font-weight: 650

  .learning-scoreboard-card .col--user
    min-width: 170px
    text-align: left

  .learning-scoreboard-card .star
    margin-right: 5px

  .learning-scoreboard-card .star-highlight
    background: var(--c-accent-soft)

  @media only screen and (max-width: 600px)
    .learning-scoreboard-card > .section__header
      padding: 18px

    .scoreboard-heading__actions
      justify-content: flex-start

    .learning-scoreboard-card > .section__header .section__tools
      justify-content: flex-start

.page--contest_main
  @media only screen and (max-width: 600px)
    .learning-activity-feature .media
      display: block

    .learning-activity-feature .section__body
      padding: 18px
