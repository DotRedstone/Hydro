.page--error
  .error__card
    max-width: 600px
    margin: rem(40px) auto rem(56px)
    padding: rem(36px) rem(36px) rem(30px)

  .error__code
    margin: 0 0 rem(6px)
    font-family: var(--font-code)
    font-size: .84rem
    font-weight: 600
    letter-spacing: .06em
    color: var(--c-link)

  .error__title
    margin: 0 0 rem(12px)
    font-family: var(--font-display)
    font-size: clamp(1.6rem, 3vw, 2.15rem)
    line-height: 1.3
    color: var(--c-heading)

  .error__message
    margin: 0 0 rem(24px)
    font-size: 1rem
    line-height: 1.7
    color: var(--c-fg-2)

  .error__actions
    display: flex
    flex-wrap: wrap
    gap: 10px
    margin-bottom: rem(22px)

    .button
      margin-bottom: 0

  .error__tech
    padding: rem(12px) rem(16px)
    border: 1px solid var(--c-border)
    border-radius: var(--r-sm)
    background: var(--c-sunken)
    font-size: .84rem
    color: var(--c-fg-3)

    summary
      cursor: pointer
      font-weight: 500
      color: var(--c-fg-2)

  .error__tech-list
    margin: rem(10px) 0 0
    display: grid
    grid-template-columns: auto minmax(0, 1fr)
    gap: 6px 14px

    dt
      color: var(--c-fg-3)

    dd
      margin: 0
      color: var(--c-fg-2)
      overflow-wrap: anywhere

    ol
      margin: 0
      padding-left: 1.2em
      list-style: decimal

  +mobile()
    .error__card
      margin: rem(16px) auto rem(24px)
      padding: rem(24px) rem(20px)
