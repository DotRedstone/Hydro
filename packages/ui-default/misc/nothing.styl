// Empty states are text-first: the previous cartoon puzzle icon was the only
// illustration in the UI and read colder than the rest of the palette.
.nothing-placeholder
  padding: rem(72px 0)
  text-align: center
  font-size: rem($font-size-title)
  color: $text-3-color

  &.compact
    padding: rem(20px 0)

.nothing-icon
  display: none
