.immersive-section, .section
  margin-bottom: rem($section-margin)

  +mobile()
    margin-bottom: rem(10px)

  &::before, &::after
    content: ' '
    display: table

  &.side
    font-size: rem($font-size-secondary)

.section
  background: $section-bg-color
  border: 1px solid token-alpha(var(--c-border), 70%)
  border-radius: var(--r)
  overflow: hidden
  box-shadow: $section-shadow

  +mobile()
    border-radius: var(--r)
    margin-left: 0
    margin-right: 0

.hasjs .section
  +above(rupture.mobile-cutoff)
    transform: translateY(rem(8px))
    opacity: 0

    &.visible
      transform: none
      opacity: 1

.section__header
  padding: rem(15px) rem(20px) rem(13px)
  min-height: rem(56px)
  border-bottom: 1px solid token-alpha(var(--c-border), 70%)
  position: relative
  display: flex
  align-items: center
  gap: rem(10px)
  flex-wrap: wrap

  &:last-child
    padding-bottom: rem($section-gap-v)

  +.section__body.no-padding:last-child
    padding-top: rem($section-gap-v) !important

.section__body
  padding: rem(18px) rem(22px)

  &.no-padding
    padding: 0 !important

.section > .section__body
  &:first-child
    padding-top: rem($section-gap-v)

  &:last-child
    padding-bottom: rem($section-gap-v)

.section__footer
  border-top: 1px solid $table-border-color
  padding: rem($section-gap-h)

.section__title
  color: $section-title-color

.section__header .section__title
  line-height: $form-control-height

// 卡片标题是界面的一部分，用界面字体；衬线只留给品牌字与页面级大标题
.section__title
  font-family: var(--font-ui)
  font-weight: 600
  letter-spacing: -0.01em

// Side rails sit next to the main column: their titles drop one step so the
// page title keeps the visual lead.
.section.side .section__title
  font-size: 1rem

h1.section__title
  font-size: 1.1rem
  font-weight: 600
  margin-bottom: rem(12px)

h2.section__title
  font-size: 1.2rem
  margin-bottom: rem(10px)

h3.section__title
  font-size: 1.05rem
  margin-bottom: rem(8px)

.section__header .section__title
  margin-bottom: 0

.section__tools
  position: static
  margin-left: auto
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: rem(8px)
  font-size: rem($font-size-secondary)

  .button,
  select,
  input
    margin-bottom: 0

  .tool-button
    appearance: none
    border: 0
    background: none
    color: $section-toolbtn-color
    margin-left: rem(5px)
    padding: rem(0 5px)
    line-height: rem(24px)
    font-size: rem($font-size-small)
    outline: 0

    border-radius: $radius-sm

    &:hover
      color: $section-toolbtn-color-hover
      background: var(--c-hover)

.section__list__item
  padding: rem($section-list-v $section-gap-h)
  border-bottom: 1px solid $table-border-color

  &:last-child
    border-bottom: 0
