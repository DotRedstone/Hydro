.menu
  padding: rem(6px)
  font-size: rem($font-size-secondary)

  .icon
    font-size: rem($font-size-icon)
    display: inline-block
    margin-right: rem(5px)
    line-height: rem(18px)
    vertical-align: top

  .hasjs &.collapsed
    display: none

.menu__item .menu
  padding: 0

.menu__link
  outline: 0
  text-align: left
  display: block
  width: 100%
  padding: rem(9px 12px)
  line-height: rem(20px)
  color: $text-2-color
  border: 0
  border-radius: var(--r-sm)
  position: relative

  // 侧栏里「进入在线编程模式」这类特殊入口：中性底 + 左侧细标记，
  // 不用整块陶土色抢走递交按钮的位置
  &.highlight
    background: var(--c-hover)
    color: var(--c-fg)
    font-weight: 550
    box-shadow: inset 2px 0 0 var(--c-accent)

  // 折叠分组的标题：一行弱化小标，而不是又一个看起来可点的菜单项
  &.expandable
    padding-top: rem(10px)
    padding-bottom: rem(6px)
    color: var(--c-fg-3)
    font-size: .78rem
    font-weight: 600
    letter-spacing: .02em

  &.expandable:after
    font-family: $icon-font-name
    font-size: rem($font-size-icon)
    content: $icon-expand_more
    position: absolute
    right: rem(12px)
    top: 50%
    line-height: 1
    margin-top: rem($font-size-icon / -2)
    transition: transform .2s ease-out-cubic
    opacity: 0.85

a.menu__link, button.menu__link
  &.half
    padding-right: 0
    width: 50%
  &.disabled
    cursor: default
    opacity: 0.5
  &:hover
    text-decoration: none
  &:not(.disabled):hover
    color: $text-1-color
    background: $menu-item-bg-color-hover
  // 选中项和顶部导航用同一种克制表达：中性底 + 左侧 2px 标记
  &.active, &.active:hover
    background: var(--c-hover)
    color: var(--c-fg)
    font-weight: 550
    box-shadow: inset 2px 0 0 var(--c-accent)

.menu__item .menu .menu__link
  padding-left: rem(14px)

// One primary row per menu (submit / join), so the main action is not one of
// thirteen identical rows.
.menu a.menu__link--primary
  &, &:visited
    background: var(--c-accent)
    color: var(--c-accent-fg)
    font-weight: 600

  &:hover
    background: var(--c-accent-hover)
    color: var(--c-accent-fg)

.menu__seperator
  height: 0
  border-top: 1px solid token-alpha(var(--c-border), 70%)
  margin: rem(7px 10px)
