.menu
  padding: rem(8px)
  font-size: rem($font-size-secondary)

  .icon
    font-size: rem($font-size-icon)
    display: inline-block
    margin-right: rem(5px)
    line-height: rem(18px)
    vertical-align: top

  .hasjs &.collapsed
    display: none

.menu__item .menu
  padding: 0

.menu__link
  outline: 0
  text-align: left
  display: block
  width: 100%
  padding: rem(12px $section-gap-h)
  line-height: rem(18px)
  color: $text-1-color
  border: 0
  border-radius: var(--r-sm)
  position: relative

  &.highlight
    background: var(--c-accent-soft)

  &.expandable:after
    font-family: $icon-font-name
    font-size: rem($font-size-icon)
    content: $icon-expand_more
    position: absolute
    right: $section-gap-h
    top: 50%
    line-height: 1
    margin-top: rem($font-size-icon / -2)
    transition: transform .2s ease-out-cubic
    opacity: 0.85

a.menu__link, button.menu__link
  &.half
    padding-right: 0
    width: 50%
  &.disabled
    cursor: default
    opacity: 0.5
  &:hover
    text-decoration: none
  &:not(.disabled):hover
    color: $text-1-color
    background: $menu-item-bg-color-hover
  &.active, &.active:hover
    background: var(--c-accent-soft)
    color: var(--c-link)
    font-weight: 500

.menu__item .menu .menu__link
  padding-left: rem($section-gap-h + 10px)

// One primary row per menu (submit / join), so the main action is not one of
// thirteen identical rows.
.menu a.menu__link--primary
  &, &:visited
    background: var(--c-accent)
    color: var(--c-accent-fg)
    font-weight: 600

  &:hover
    background: var(--c-accent-hover)
    color: var(--c-accent-fg)

.menu__seperator
  height: 0
  border-top: 1px solid token-alpha(var(--c-border), 70%)
  margin: rem(7px 10px)
