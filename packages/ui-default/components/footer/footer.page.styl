$footer-extra-link-gap = 20px

.footer
  background: $footer-bg-color
  color: $text-1-color

  a, .link
    &, &:visited
      color: $text-2-color

    &:hover
      color: $primary-color

  h1
    margin: 0
    font-family: var(--font-display)
    font-size: .95rem
    font-weight: 600
    letter-spacing: -.01em

    +mobile()
      padding: rem($grid-padding)
      cursor: pointer
      font-size: rem($font-size-secondary)

// One hairline opens the footer; the columns themselves carry no rule, which is
// what made the old footer look like a four-cell table.
.footer__links
  border-top: 1px solid token-alpha(var(--c-border), 70%)

.footer__category
  padding-top: rem(22px)
  padding-bottom: rem(16px)

  +mobile()
    padding-top: rem($grid-padding)
    padding-bottom: rem($grid-padding)
    border-bottom: 1px solid $border-2-color

    &.expandable
      padding: 0

  .expand-icon
    display: none

    +mobile()
      display: inline-block

  &.expanded .expand-icon
    transform: rotate(180deg)

.footer__category__list
  margin: rem(6px 0 0)
  font-size: .82rem
  line-height: 1.85

  +mobile()
    margin-top: 0
    padding-left: rem($grid-padding)
    padding-right: rem($grid-padding)

.footer__category__expander
  +mobile()
    display: none

  +above(rupture.mobile-cutoff)
    display: block !important

.footer__extra-left
  float: left

.footer__extra-right
  float: right

.footer__extra-link
  padding: rem(12px 0)
  font-size: .78rem
  color: var(--c-fg-3)

.footer__extra-link-item
  float: left
  line-height: 1.7

.footer__extra-left .footer__extra-link-item
  margin-right: rem($footer-extra-link-gap)

.footer__extra-right .footer__extra-link-item
  margin-left: rem($footer-extra-link-gap)

// the immersive layout no longer has a dark hero behind it, so the footer
// keeps the normal palette instead of the old white-on-image treatment
.layout--immersive
  .footer
    background: none
    color: $text-1-color

    a, a:visited, a:active
      color: $text-2-color

    a:hover
      color: $primary-color

+mobile()
  .footer__extra-left, .footer__extra-right
    float: none
    display: block

    .footer__extra-link-item
      float: none
      display: inline-block
      margin-left: 0
      margin-right: $footer-extra-link-gap
