.record-status--text
  for key, value in $record-status-color
    &.{key}
      color: value !important

.record-status--icon
  display: inline-block
  width: 1.15em
  for key, value in $record-status-icon
    &.{key}:before
      content: value
      color: $record-status-color[key]

.record-status--border
  border-left: rem(3px) solid transparent
  for key, value in $record-status-color
    &.{key}
      border-left: rem(3px) solid token-tint(value, 90%)

  // a pass stays visible when scanning a long record table
  &.pass
    background: var(--c-ok-soft)

.record-status--background
  color: var(--c-accent-fg)

  for key, value in $record-status-color
    &.{key}
      background: value

