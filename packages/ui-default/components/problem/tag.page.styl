.problem__tags
  margin: 0 !important
  padding: 0 !important
  list-style: none !important
  font-size: 0
  word-break: keep-all
  display: flex
  flex-wrap: wrap

.problem__tag
  display: inline-block
  vertical-align: top
  height: rem($table-lh)
  margin: rem(0 2px 2px 0) !important
  padding: 0 !important

.problem__tag-item
  display: inline-flex
  flex-direction: row
  align-items: center
  border: 0
  box-shadow: none
  border-radius: $radius-pill
  max-width: 100%
  position: relative
  background-color: token-alpha(var(--c-fg), 8%)
  color: $text-2-color
  font-size: rem(12px)
  line-height: 1.5
  padding: rem(2px 10px)
  &:hover
    text-decoration: none
  > span
    display: flex
    align-items: center
  > *
    flex-grow: 0
    flex-shrink: 0
    margin-right: 8px
  &:before,
  > *
    margin-right: 4px
  > :last-child
    margin-right: 0
  &:focus
    outline: 2px solid var(--c-focus-ring)
    outline-offset: 0
    -moz-outline-radius: 6px
  &.interactive
    cursor: pointer
    &:hover
      background: token-alpha(var(--c-neutral), 30%)
      color: $text-1-color

.tag
  display: inline-flex
  align-items: center
  padding: rem(2px 10px)
  border-radius: $radius-pill
  background: token-alpha(var(--c-fg), 8%)
  color: $text-2-color
  font-size: rem(12px)
  line-height: 1.5
  white-space: nowrap

.problem__tag-link
  display: inline-flex
  align-items: center
  padding: rem(2px 10px)
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  max-width: rem(250px)
  line-height: 1.5
  border-radius: $radius-pill
  background: token-alpha(var(--c-fg), 8%)
  color: $text-2-color !important
  font-size: rem(12px)
  transition: background .15s, color .15s

  &:hover
    background: var(--c-accent-soft)
    color: $primary-color !important
    text-decoration: none

.col--problem-name
  .problem__tags
    float: right

  .problem__tag
    margin: rem(0 2px 0 0) !important
