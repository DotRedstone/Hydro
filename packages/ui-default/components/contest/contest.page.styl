.contest-type-tag
.contest-tag
.contest-tag-rated
  font-size: rem($font-size-small)
  display: inline-block
  line-height: rem(22px)
  padding: rem(0 10px)
  vertical-align: middle
  border-radius: var(--r)

  &:hover
    text-decoration: none
    color: var(--c-accent-fg) !important

.contest-tag-rated
  background: var(--c-warn)
  color: var(--c-accent-fg)

  .icon
    margin-right: rem(5px)

.contest-type-tag
  &, &:visited
    &, .supplementary &
      color: var(--c-accent-fg)

  .icon
    margin-right: rem(5px)

for key, value in $contest-color
  .contest-type--{key} .contest-type-tag
    background: value

    &:hover
      background: token-tint(value, 80%)

.contest-tag
  border: 1px solid $supplementary-border-color

  &:hover
    background: $primary-color
    border-color: $primary-color

// The remaining time is docked under the nav instead of pinned to the viewport
// corner, where it used to sit on top of the page and the nav bar.
.contest-timer
  position: fixed
  left: 50%
  bottom: 16px
  transform: translateX(-50%)
  z-index: 900
  margin: 0
  padding: 6px 12px
  border: 1px solid var(--c-border)
  border-radius: var(--r-pill)
  background: var(--c-surface)
  box-shadow: var(--shadow-card)
  color: var(--c-fg)
  font-family: var(--code-font-family)
  font-size: .82rem
  font-weight: 600
  font-variant-numeric: tabular-nums
  letter-spacing: .02em
  line-height: 1.4
  +mobile()
    visibility: hidden !important

.contest-problems
  font-size: 0.9375rem;
  font-weight: 400;
  line-height: 1.375rem;
  text-align: left;
  box-sizing: border-box;
  font-variant-ligatures: none!important;
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(1.5rem,1fr));
  justify-content: center;
  row-gap: 0.75rem;
  column-gap: 0.5rem;
  padding-bottom: 0.5rem;
  width: rem(180px);

  +mobile()
    display: none;

  > a
    text-decoration: none;
    background-color: transparent;
    cursor: pointer;
    display: flex;
    height: 1.5rem;
    width: 1.5rem;
    align-items: center;
    justify-content: space-around;
    border-radius: var(--r-xs);
    position: relative;
    transition: opacity 0.2s;
    color: var(--c-neutral);
    &.pass
      color: var(--c-ok);
      &:before
        background: var(--c-ok);
    &.fail
      color: var(--c-bad);
      &:before
        background: var(--c-bad);
    &.pending
      color: var(--c-warn);
      &:before
        background: var(--c-warn);

    &:after
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      box-sizing: border-box;
      border: 2px solid currentColor;
      border-radius: var(--r-xs);
      opacity: 0.3;
    
    &.active:after
      border: 3px solid var(--c-warn);

    &:before
      opacity: 0.5;
    
    &.pass, &.fail
      &:not(:hover) .id
        display: none;
      
      &:hover .icon
        display: none;
