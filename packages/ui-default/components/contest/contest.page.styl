// 比赛类型 / Rated 标记：默认是纯文本 + 彩色图标，不再是一块实色胶囊。
// 列表里每条比赛都挂两个色块，一屏下来全是颜色，反而看不出重点。
.contest-tag
.contest-tag-rated
  display: inline-flex
  align-items: center
  gap: rem(4px)
  padding: rem(0 7px)
  border-radius: var(--r-xs)
  font-size: .74rem
  // 24px 高的胶囊会把所在行从 86px 顶到 96px，行内两块文字还被压低 5px
  line-height: 1.35
  vertical-align: middle

.contest-tag-rated
  border: 1px solid var(--c-border-strong)
  color: var(--c-fg-2)

  .icon
    color: var(--c-warn)

.contest-type-tag
  display: inline-flex
  align-items: center
  gap: rem(4px)
  font-size: rem($font-size-small)
  line-height: 1.5

  &, &:visited
    &, .supplementary &
      color: var(--c-fg-2)

  .icon
    color: var(--c-fg-3)

  &:hover
    &, .supplementary &
      color: var(--c-fg)
    text-decoration: none

for key, value in $contest-color
  .contest-type--{key} .contest-type-tag .icon
    color: value

.contest-tag
  border: 1px solid $supplementary-border-color

  &:hover
    border-color: var(--c-fg-3)

// The remaining time is docked under the nav instead of pinned to the viewport
// corner, where it used to sit on top of the page and the nav bar.
.contest-timer
  position: fixed
  left: 50%
  bottom: 16px
  transform: translateX(-50%)
  z-index: 900
  margin: 0
  padding: 6px 12px
  border: 1px solid var(--c-border)
  border-radius: var(--r-pill)
  background: var(--c-surface)
  box-shadow: var(--shadow-card)
  color: var(--c-fg)
  font-family: var(--code-font-family)
  font-size: .82rem
  font-weight: 600
  font-variant-numeric: tabular-nums
  letter-spacing: .02em
  line-height: 1.4
  +mobile()
    visibility: hidden !important

.contest-problems
  font-size: 0.9375rem;
  font-weight: 400;
  line-height: 1.375rem;
  text-align: left;
  box-sizing: border-box;
  font-variant-ligatures: none!important;
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(1.5rem,1fr));
  justify-content: center;
  row-gap: 0.75rem;
  column-gap: 0.5rem;
  padding-bottom: 0.5rem;
  width: rem(180px);

  +mobile()
    display: none;

  > a
    text-decoration: none;
    background-color: transparent;
    cursor: pointer;
    display: flex;
    height: 1.5rem;
    width: 1.5rem;
    align-items: center;
    justify-content: space-around;
    border-radius: var(--r-xs);
    position: relative;
    transition: opacity 0.2s;
    color: var(--c-neutral);
    &.pass
      color: var(--c-ok);
      &:before
        background: var(--c-ok);
    &.fail
      color: var(--c-bad);
      &:before
        background: var(--c-bad);
    &.pending
      color: var(--c-warn);
      &:before
        background: var(--c-warn);

    &:after
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      box-sizing: border-box;
      border: 2px solid currentColor;
      border-radius: var(--r-xs);
      opacity: 0.3;
    
    &.active:after
      border: 3px solid var(--c-warn);

    &:before
      opacity: 0.5;
    
    &.pass, &.fail
      &:not(:hover) .id
        display: none;
      
      &:hover .icon
        display: none;
