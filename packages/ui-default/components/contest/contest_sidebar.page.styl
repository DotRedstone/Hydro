.contest-sidebar__bg
  display: block
  background: var(--c-sunken)
  border-bottom: 1px solid var(--c-border)
  color: var(--c-heading) !important
  font-size: rem($font-size)
  padding: 0

  h1
    margin: 0
    font-family: var(--font-ui)
    font-size: 1.05rem
    font-weight: 600
    line-height: 1.45
    color: var(--c-heading)

  &:hover
    background: var(--c-hover)
    text-decoration: none

  .contest-sidebar__status
    margin-top: rem(8px)
    color: var(--c-fg-2)
    font-size: .84rem

.contest-attend-dialog__modes
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: rem(10px)
  margin-bottom: rem(12px)

  .button
    margin-bottom: 0
    text-align: center
    white-space: normal

  +mobile()
    grid-template-columns: 1fr

.contest-attend-dialog__hint
  margin-bottom: rem(12px)

.contest-attend-dialog__desc
  margin: rem(4px) 0 rem(12px)

.contest-attend-dialog__team-select
  margin-top: rem(12px)
