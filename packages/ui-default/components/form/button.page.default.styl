@import './var.inc.styl'

// Button look. Layout/size lives in button.page.styl.
.button
  &:not(.codicon)
    background-color: transparent
    border: 1px solid $border-1-color
    border-radius: $radius-pill
    font-weight: 500
    transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s
    transition-timing-function: ease-out-sine

    &, &:visited, &:hover
      &, .typo &
        color: $text-1-color

    &:not(.disabled)
      &:hover
        background-color: var(--c-hover)

      &:focus-visible
        outline: none
        box-shadow: 0 0 0 3px $input-focus-color

    &.rounded
      border-radius: $radius-pill

    &.primary
      border-color: $primary-color
      background-color: $primary-color

      &, &:visited, &:hover
        &, .typo &
          color: var(--c-accent-fg)

      &:not(.disabled)
        &:hover
          background-color: var(--c-accent-hover)
          border-color: var(--c-accent-hover)

    &.disabled
      cursor: default
      opacity: 0.5

// "inverse" used to mean "on top of the photo background". The new layout has
// no photo, so it renders as a quiet outline button.
.button.inverse
  line-height: rem($form-control-height - 2)
  border: 1px solid $border-1-color
  background: transparent

  &, &:visited
    &, .typo &
      color: $text-1-color

  &:not(.disabled)
    &:hover, &:focus
      border-color: $primary-color
      background: transparent
      box-shadow: none
      &, .typo &
        color: $primary-color
