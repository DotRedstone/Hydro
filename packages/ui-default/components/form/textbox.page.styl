@import './var.inc.styl'

// the autocomplete widget wraps the real input in its own bordered white box;
// the input already carries the design border, so the wrapper must stay invisible
.autocomplete-container .autocomplete-wrapper
  padding: 0
  border: 0
  background: transparent

.autocomplete-container
  max-width: 100%

// Normal Textbox
input.textbox, textarea.textbox, span.textbox
  form-styles()
  background-color: $input-background-color
  outline: $input-outline
  transition: outline-color .2s, border-color .2s
  transition-timing-function: ease-out-cubic

  &::placeholder
    color: $text-3-color

  &:focus
    border-color: $input-focus-border-color
    outline: $input-focus-outline
    outline-offset: 0

  // Overwrite, for IE compatibility
  &:read-only
    outline: 0

  &:disabled
    opacity: 0.5

textarea.textbox
  height: rem(200px)

input.textbox.compact
  margin-bottom: 0
  height: rem($compact-control-height)
  line-height: rem($compact-control-height - 2)
  padding-top: 0
  padding-bottom: 0

div.textbox
  min-height: rem(200px)
  margin-bottom: 1rem

.data-table
  input.textbox, textarea.textbox, span.textbox
    margin-bottom: 0

  div.autocomplete-container
    margin-bottom: 0 !important

// Material Textbox
label.textbox.material
  input
    form-styles()
    border: 0
    background: none
    outline: 0
    padding-left: 0
    padding-right: 0
    color: $text-1-color
    border-radius: 0
    border-bottom: 1px solid $border-1-color
    transition: border-color .2s ease-out-cubic

    &:disabled, &:read-only
      color: $text-3-color

    &:enabled:read-write:hover
      border-color: $text-3-color

    &:enabled:read-write:focus
      border-color: $input-focus-border-color

  &.focus
    color: $text-1-color

label.textbox.material.inverse
  color: $immersive-text-color

  input
    color: $immersive-text-color
    border-color: $border-1-color

    &:disabled, &:read-only
      color: $text-3-color

    &:enabled:read-write:hover
      border-color: $immersive-text-color

    &:enabled:read-write:focus
      border-color: $immersive-primary-color

  &.focus
    color: $immersive-primary-color

// Components that upgrade a textbox into an autocomplete keep the original input
// as a hidden value carrier and render their own controlled input next to it.
// Without this rule both inputs show up, one of them empty.
input.textbox.autocomplete-dummy,
input.autocomplete-dummy
  display: none !important
