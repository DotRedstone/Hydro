// 弹出面板（popup panel）的统一外观。
//
// 右键菜单、原生下拉框的候选面板都用这一套：一张 surface 卡片 + 一行行可点条目。
// 只有定位、动画这类和“怎么弹出来”有关的规则留在各自的组件里
// （components/contextmenu、components/selectmenu）。

.menu-panel
  display: flex
  flex-direction: column
  gap: 1px
  min-width: rem(160px)
  max-width: rem(320px)
  max-height: rem(320px)
  padding: 6px
  border: 1px solid var(--c-border)
  border-radius: var(--r)
  background: var(--c-surface)
  box-shadow: var(--shadow-pop)
  overflow-y: auto
  overscroll-behavior: contain
  user-select: none
  // 输入框可能在弹窗里（dialog 是 1000），面板要压在上面
  z-index: 1100

  &[hidden]
    display: none

.menu-panel__item
  display: flex
  align-items: center
  gap: 9px
  width: 100%
  min-height: rem(32px)
  padding: 6px 10px
  border: 0
  border-radius: var(--r-sm)
  background: none
  color: var(--c-fg-2)
  font-size: .855rem
  line-height: 1.4
  text-align: left
  cursor: pointer
  white-space: nowrap
  transition: background-color .13s ease-out-cubic, color .13s ease-out-cubic

  &[hidden]
    display: none

  .icon
    width: 1.05em
    flex: 0 0 auto
    color: var(--c-fg-3)
    font-size: .95rem
    text-align: center

  &:hover,
  &:focus-visible,
  &.is-active
    background: var(--c-sunken)
    color: var(--c-fg)
    outline: none

    .icon
      color: var(--c-fg-2)

  &:active
    background: var(--c-hover)

  &:disabled,
  &.is-disabled
    color: var(--c-fg-3)
    cursor: default
    opacity: .55

    &:hover
      background: none

  &[aria-selected='true']
    color: var(--c-fg)
    font-weight: 550

.menu-panel__label
  flex: 1 1 auto
  min-width: 0
  overflow: hidden
  text-overflow: ellipsis

.menu-panel__hint
  flex: 0 0 auto
  color: var(--c-fg-3)
  font-size: .78rem

.menu-panel__check
  flex: 0 0 auto
  color: var(--c-link) !important

// 分组标题（optgroup 或菜单分组名）
.menu-panel__group-label
  padding: 6px 10px 2px
  color: var(--c-fg-3)
  font-size: .74rem
  font-weight: 600
  letter-spacing: .04em

.menu-panel__sep
  height: 0
  margin: 4px 6px
  border-top: 1px solid token-alpha(var(--c-border), 70%)

@media (prefers-reduced-motion: reduce)
  .menu-panel__item
    transition: none
