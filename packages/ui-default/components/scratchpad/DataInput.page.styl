// 自测面板的输入 / 输出框：等宽、纸面、聚焦时给一圈陶土色内描边
.scratchpad__data-input
  height: 100%
  width: 100%
  padding: rem(10px 12px)
  border: 0
  background: var(--c-surface)
  color: var(--c-fg)
  font-family: var(--font-code)
  font-size: .82rem
  line-height: 1.6
  outline: 0
  resize: none
  overflow: auto
  transition: box-shadow .15s ease-out-cubic

  &::placeholder
    color: var(--c-fg-3)

  &:focus
    box-shadow: inset 0 0 0 1px token-alpha(var(--c-accent), 45%)

  pre
    margin: 0
    padding: 0
    background: none
    font: inherit
    color: inherit

// 输入 / 输出两半各带一条小标题，避免看起来是两块空白
.scratchpad__pretest-pane
  display: flex
  flex-direction: column
  height: 100%
  min-width: 0

  & > div:last-child
    flex: 1
    min-height: 0

.scratchpad__pretest-label
  flex: none
  padding: rem(5px 12px)
  border-bottom: 1px solid var(--c-border)
  background: var(--c-surface)
  color: var(--c-fg-3)
  font-size: .7rem
  font-weight: 600
  letter-spacing: .06em
  text-transform: uppercase
