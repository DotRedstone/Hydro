// 在线编程模式（scratchpad）：整页是一块工作台
//   左：图标栏  |  中：题面 / 设置  |  右：工具条 + 编辑器，下面是自测与评测记录
// 分栏由 Allotment 负责，这里只把它的分隔条换成设计令牌。

.scratchpad-container
  position: absolute
  background: var(--c-bg)

#scratchpad
  position: absolute
  // 四周留一档、加圆角与描边：整屏模式贴到视口边缘会显得被撑爆，
  // 收进一张工作台卡片里，读起来和平时的卡片布局是同一套语言
  left: rem(12px)
  right: rem(12px)
  top: calc(var(--school-nav-height, 50px) + 12px)
  width: auto
  bottom: rem(12px)
  border: 1px solid var(--c-border)
  border-radius: var(--r-lg)
  box-shadow: var(--shadow-float)
  overflow: hidden
  background: var(--c-bg)
  color: var(--c-fg)
  // Allotment 靠这几个变量画分隔线与拖拽指示，改令牌就不用管它的哈希类名
  --separator-border: var(--c-border)
  --focus-border: var(--c-accent)
  --sash-size: 10px
  --sash-hover-size: 2px

  .splitpane-fill
    background: var(--c-surface)

.scratchpad__problem
  position: absolute
  left: 0
  top: 0
  width: 100%
  height: 100%
  overflow: auto
  background: var(--c-surface)

  // 整屏工作台里的题面要给点呼吸感，别贴着分栏线
  .problem-content
    padding: rem(20px 26px 40px)

  .problem-content > .section:first-child
    margin-top: 0

.scratchpad__toolbar__pretest.enabled:hover .icon
  color: var(--c-bad)

.scratchpad__toolbar__submit.enabled:hover .icon
  color: var(--c-ok)

.scratchpad__records__table
  &.loading
    // make a flash by setting opacity, otherwise users
    // won't think that refreshing is completed!
    opacity: 0.6

  .col--at
    width: rem(120px)

  .col--time,
  .col--memory
    width: rem(70px)

  .col--detail
    border-right: 0

  .icol
    display: inline-block

  .icol--pretest
    width: rem(60px)

    .flag
      font-size: rem(12px)
      color: var(--c-accent-fg)
      padding: rem(2px 3px)

  .icol--stat
    color: $text-3-color
    width: rem(60px)

// 空编辑器提示：题目没配文件时编辑器是纯空白，看起来像没加载出来
.scratchpad__editor-pane
  position: relative

.scratchpad__editor-hint
  position: absolute
  top: rem(58px)
  left: rem(72px)
  right: rem(24px)
  color: var(--c-fg-3)
  font-size: .87rem
  line-height: 1.6
  pointer-events: none
  user-select: none
