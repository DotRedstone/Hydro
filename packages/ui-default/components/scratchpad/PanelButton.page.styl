@import './var.inc.styl'

.scratchpad__panel-button
  display: inline-flex
  align-items: center
  height: rem(24px)
  margin: 0
  padding: rem(0 8px)
  border: 0
  border-radius: var(--r-sm)
  background: none
  color: var(--c-fg-3)
  font-size: .76rem
  cursor: pointer
  outline: 0
  transition: background-color .15s ease-out-cubic, color .15s ease-out-cubic

  &:hover
    background: var(--c-hover)
    color: var(--c-fg)
