// 左侧图标栏：整块工作台的“导航”
.scratchpad__tablist
  display: flex
  flex-direction: column
  align-items: center
  gap: rem(6px)
  height: 100%
  padding: rem(10px 0)
  border-right: 1px solid var(--c-border)
  background: var(--c-sunken)
  user-select: none

  div
    display: flex
    width: rem(36px)
    height: rem(36px)
    flex-direction: row
    align-items: center
    justify-content: center
    border-radius: var(--r-sm)
    color: var(--c-fg-3)
    fill: currentColor
    cursor: pointer
    transition: background-color .15s ease-out-cubic, color .15s ease-out-cubic

    svg
      width: rem(20px)
      height: rem(20px)

    &:hover
      background: var(--c-hover)
      color: var(--c-fg)

  div.scratchpad__tab-active
    background: var(--c-surface)
    color: var(--c-link)
    box-shadow: var(--shadow-card)
    cursor: default
