.scratchpad__tablist
  user-select: none

  div
    display: flex
    width: 50px
    height: 50px
    font-size: 28px
    flex-direction: row
    align-items: center
    justify-content: center
    margin: rem(8px) 0
    fill: $text-2-color
    color: $text-2-color
    cursor: pointer
    &:hover
      fill: $text-1-color
      color: $text-1-color

  div.scratchpad__tab-active
    border-left: 4px solid var(--c-accent)
    fill: $text-1-color
    color: $text-1-color
    cursor: default
