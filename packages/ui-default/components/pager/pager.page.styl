.pager
  text-align: center
  font-size: rem($font-size-small)
  display: flex
  flex-wrap: wrap
  justify-content: center
  align-items: center
  gap: rem(2px)
  padding: rem(10px 0)

  &:empty
    display: none

  // The old design drew a 2px rule across the whole section and highlighted the
  // current page by recolouring that rule; with a single page it read as a
  // stray line. The pager is now a row of chips.
  &.pager-bottom
    margin-bottom: rem(10px)
    border-top: 1px solid $border-2-color

  &.pager-top
    margin-top: rem(10px)
    border-bottom: 1px solid $border-2-color

  li
    margin: 0
    display: inline-block

.pager__item
  display: inline-block
  min-width: rem(30px)
  padding: rem(5px 9px)
  border-radius: $radius-sm
  text-decoration: none
  border: 0
  transition: background .15s linear, color .15s linear
  color: $text-3-color
  line-height: 1.4

  &.link
    &, .typo &
      color: $text-3-color

    &:hover
      background: var(--c-hover)
      text-decoration: none
      &, .typo &
        color: $text-1-color

  &.current
    background: var(--c-accent-soft)
    color: $primary-color !important
    font-weight: 600

  &.disabled
    opacity: 0.4

+mobile()
  .pager__item
    &.ellipsis,
    &.first,
    &.previous,
    &.next,
    &.last
      display: none
