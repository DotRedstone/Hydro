// flatpickr 日期选择器：库自带的 flatpickr.min.css 是白底、#569ff7 选中、#e6e6e6 区间，
// 深色主题下是一整块白板，也不随配色切换。这里统一改成设计令牌。
// 库样式由 datepicker.page.tsx 直接 import，打包顺序不受控，选择器前加 body 提高特异性。

body .flatpickr-calendar
  background: var(--c-surface)
  border: 1px solid var(--c-border)
  border-radius: var(--r-sm)
  box-shadow: var(--shadow-pop)
  color: var(--c-fg)
  font-family: var(--font-family)

  &.arrowTop:before, &.arrowTop:after
    border-bottom-color: var(--c-border)
  &.arrowBottom:before, &.arrowBottom:after
    border-top-color: var(--c-border)

body .flatpickr-months
  .flatpickr-month
    background: transparent
    color: var(--c-fg)
    fill: var(--c-fg)
  .flatpickr-prev-month, .flatpickr-next-month
    color: var(--c-fg-2)
    fill: var(--c-fg-2)
    &:hover
      color: var(--c-accent)
      svg
        fill: var(--c-accent)

body .flatpickr-current-month
  color: var(--c-fg)
  .flatpickr-monthDropdown-months, input.cur-year
    color: var(--c-fg)
    background: transparent
  .flatpickr-monthDropdown-months .flatpickr-monthDropdown-month
    background: var(--c-surface)
    color: var(--c-fg)
  .numInputWrapper span.arrowUp:after
    border-bottom-color: var(--c-fg-2)
  .numInputWrapper span.arrowDown:after
    border-top-color: var(--c-fg-2)

body span.flatpickr-weekday
  background: transparent
  color: var(--c-fg-3)

body .flatpickr-day
  color: var(--c-fg)
  border-color: transparent

  &:hover, &:focus
    background: var(--c-hover)
    border-color: var(--c-hover)

  &.today
    border-color: var(--c-border-strong)
    &:hover, &:focus
      background: var(--c-hover)
      border-color: var(--c-accent)
      color: var(--c-fg)

  &.inRange, &.prevMonthDay.inRange, &.nextMonthDay.inRange
    background: var(--c-accent-soft)
    border-color: var(--c-accent-soft)
    box-shadow: -5px 0 0 var(--c-accent-soft), 5px 0 0 var(--c-accent-soft)

  &.selected, &.startRange, &.endRange,
  &.selected:hover, &.startRange:hover, &.endRange:hover,
  &.selected:focus, &.startRange:focus, &.endRange:focus
    background: var(--c-accent)
    border-color: var(--c-accent)
    color: var(--c-accent-fg)

  &.prevMonthDay, &.nextMonthDay, &.flatpickr-disabled, &.flatpickr-disabled:hover
    color: var(--c-fg-3)

body .flatpickr-time
  border-top-color: var(--c-border)
  input, .flatpickr-am-pm, .flatpickr-time-separator
    color: var(--c-fg)
    background: transparent
  input:hover, input:focus, .flatpickr-am-pm:hover, .flatpickr-am-pm:focus
    background: var(--c-hover)
