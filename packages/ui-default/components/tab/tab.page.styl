@import './var.inc.styl'

// No JavaScript
.section__tab-item
  margin: rem(20px) 0
  border-bottom: 1px solid $border-2-color
  padding: 0 rem($section-gap-h) rem($section-gap-v)

.section__tab-title
  font-size: rem($font-size-title)
  color: $text-3-color
  margin-bottom: 0.8em

// Has JavaScript
.section__tab-header-wrapper
  overflow: hidden

.section__tab-header
  padding: 0 rem($section-gap-h)
  padding-top: rem($tab-item-shadow-size)
  overflow-x: auto
  white-space: nowrap
  padding-bottom: 20px
  margin-bottom: -20px

  +mobile()
    padding-top: 0
    padding-right: rem($section-gap-h + 50px)
    webkit-overflow-scrolling: touch
    mask-image: linear-gradient(to right, token-alpha(var(--c-fg), 100%) 80%, token-alpha(var(--c-fg), 0%));

.section__tab-header-item
  display: inline-block
  font-size: rem($font-size-secondary)
  line-height: rem($tab-item-height)
  height: rem($tab-item-height)
  padding: 0 rem(14px)
  margin-right: rem(4px)
  user-select: none
  position: relative
  color: $text-3-color
  border-bottom: 2px solid transparent
  transition: color .15s, border-color .15s

  &:hover
    color: $text-1-color

  &.selected
    color: $text-1-color
    border-bottom-color: $primary-color

  +mobile()
    line-height: rem($tab-item-height-mobile)
    height: rem($tab-item-height-mobile)

.section__tab-container.immersive
  .section__tab-header-item
    color: token-alpha(var(--c-inverse-fg), 90%)
    border-radius: 1px 1px 0 0
    cursor: pointer
    transition: background .2s ease-out-cubic

    &:hover
      color: var(--c-inverse-fg)

    &.selected
      background: var(--c-surface)
      color: $text-1-color
      box-shadow: var(--shadow-pop)

    +mobile()
      &.selected
        box-shadow: none
        background: transparent
        color: var(--c-inverse-fg)

        &::after
          position: absolute
          left: 0
          width: 100%
          bottom: 0
          height: 3px
          background: $secondary-color
          content: ''

.section__tab-container:not(.immersive)
  .section__tab-header
    padding-top: 0 !important

  .section__tab-header-item
    border-top: 3px solid transparent;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    margin-right: 0

    &:hover
      border-color: var(--c-info);
      background: var(--c-hover);
    
    &.tab--active
      border-color: var(--c-accent);

    &.selected
      border-color: var(--c-accent);

.section__tab-content
  position: relative

  .section__tab-main
    display: none
    vertical-align: top
    width: 100%

    &.active
      display: inline-block
