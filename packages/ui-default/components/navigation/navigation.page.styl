.nav--placeholder
  height: $nav-item-height

.nav
  position: relative
  left: 0
  top: 0
  width: 100%
  height: rem($nav-item-height)
  font-size: rem($font-size-secondary)
  font-weight: 500
  transition: background .2s
  transition-timing-function: ease-out-cubic
  z-index: 500
  background: var(--c-nav-bg)
  border-bottom: 1px solid var(--c-border)
  backdrop-filter: saturate(160%) blur(10px)
  -webkit-backdrop-filter: saturate(160%) blur(10px)

  .nav__item
    color: $text-1-color
    &.nav--active
      border-color: $nav-item-active-color
      &:before
        box-shadow: 0 0 30px $nav-item-active-color,
                    0 0 30px $nav-item-active-color
    &:hover
      border-color: $nav-item-hover-color
      background: var(--c-hover)
      &:before
        box-shadow: none

  .nav__item--round
    border-color: $primary-color
    background: $primary-color
    color: var(--c-accent-fg)

    &:hover
      background-color: var(--c-accent-hover)
      border-color: var(--c-accent-hover)
      color: var(--c-accent-fg)

    &:visited, &:active
      color: var(--c-accent-fg)

  .hasjs &
    position: fixed

  .nojs &
    box-shadow: var(--shadow-pop)
    margin-bottom: rem(-($nav-item-height))
    overflow: hidden

.nav > .row
  transition: max-width .5s ease-out-cubic

.nav--shadow
  position: fixed
  left: 0
  top: 0
  width: 100%
  height: rem($nav-item-height)
  z-index: 300
  transition: box-shadow .2s
  transition-timing-function: ease-out-cubic
  box-shadow: 0 1px 0 var(--c-border)

  .nojs &
    display: none

.nav__list, .nav__list-item
  list-style: none

.nav__list--main
  float: left

.nav__item
  display: block
  line-height: rem($nav-item-height - 6)
  padding: rem(0 14px)
  margin: rem(11px 2px)
  line-height: rem($nav-item-round-height)
  border: 0
  border-radius: $radius-pill
  color: $text-1-color
  transition: border-color .2s, background .2s, color .2s
  transition-timing-function: ease-out-cubic
  position: relative

  &:before
    content: ''
    position: absolute
    left: 0
    top: -1px
    width: 100%
    height: 1px

  &:visited, &:active
    color: $text-1-color

  &.nav--active
    color: $header-1-color
    background: var(--c-sunken)
    &:before
      box-shadow: none

  &:hover
    text-decoration: none
    color: $text-1-color
    border-color: $border-1-color
    background: var(--c-hover)


.nav__list--secondary
  float: right

.nav__item--round
  display: block
  line-height: rem($nav-item-round-height - 2 * $nav-item-round-border)
  margin: rem((($nav-item-height - $nav-item-round-height) / 2) 0)
  padding: rem(0 18px)
  border-radius: var(--r-pill)
  color: var(--c-accent-fg)
  background: $primary-color
  border: $nav-item-round-border solid $primary-color
  font-weight: 500
  transition: background .2s, color .2s, border-color .2s
  transition-timing-function: ease-out-cubic

  &:visited, &:active
    color: var(--c-accent-fg)

  &:hover
    text-decoration: none
    background: var(--c-accent-hover)
    border-color: var(--c-accent-hover)
    color: var(--c-accent-fg)

.nav__list-item
  float: left

.nav__list--main .nav__item--round
  margin-right: rem(5px)

.nav__list--secondary .nav__item--round
  margin-left: rem(5px)

.nav__wordmark
  display: block
  font-family: $header-font-family
  font-size: rem(21px)
  font-weight: 500
  letter-spacing: -0.02em
  color: $header-1-color
  line-height: rem($nav-item-height)
  padding: rem(0 6px 0 2px)
  white-space: nowrap

.nav__logo
  display: block
  filter: var(--logo-filter)
  height: rem($nav-logo-height - 4)
  margin: rem((($nav-item-height - $nav-logo-height) / 2) 5px)

  &:hover
    text-decoration: none

  +mobile()
    display: none

// For Mobile: show a slideout vertical arranged menu
+mobile()

  .nav .columns
    padding: 0

  .nav--shadow
    display: none

  .nav.slideout-menu
    background: var(--c-inverse-bg)

  .nav__list
    float: none

  .nav__list-item
    float: none

  .nav__item,
  .nav__item--round,
  .nav .dropdown-target.menu .menu__link
    line-height: rem($nav-item-height - 6)
    padding: rem(0 20px 3px 20px)
    border: 0
    border-left: 3px solid transparent
    margin: 0
    border-radius: 0
    background: none

    .icon
      line-height: inherit

    &.nav--active
      border-color: $nav-item-active-color

    &:visited, &:active
      background: none
      color: var(--c-inverse-fg)

    &:hover
      border-color: $nav-item-hover-color
      background: token-alpha(var(--c-inverse-fg), 10%)
      color: var(--c-inverse-fg)

  .nav__item
    &:before
      left: -2px
      top: 0
      height: 100%
      width: 1px

  .nav .dropdown-target.menu
    display: block
    background: none
    border: 0
    box-shadow: none

    .menu__link
      padding-left: rem(35px)

    .menu__seperator
      display: none

  .nav__list--secondary
    border-top: 1px solid token-alpha(var(--c-inverse-fg), 20%)
