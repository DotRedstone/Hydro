// Sign-in dialog: same shell as the auth pages (form panel + warm side panel).
// Everything reads from the shared tokens, so it follows the active palette.
$signin_form_width = 360px

.account-signin-dialog
  display: flex
  flex-direction: row-reverse
  align-items: stretch
  max-width: rem(760px)
  overflow: hidden
  background: var(--c-surface)
  border: 1px solid token-alpha(var(--c-border), 70%)
  border-radius: var(--r-lg)
  box-shadow: var(--shadow-float)
  position: relative

// Promo panel: used to be a black overlay with inverse text, which turned into
// dark-on-dark once the palette gained a dark theme.
.account-signin-dialog .dialog--signin__bg
  position: static
  flex: 1 1 auto
  display: flex
  align-items: center
  background: var(--c-accent-soft)
  box-shadow: none
  z-index: auto

.account-signin-dialog .dialog--signin__side
  position: static
  transform: none
  width: auto
  padding: rem(34px 30px)
  color: var(--c-fg-2)

.account-signin-dialog .dialog--signin__side h1
  margin: 0 0 10px
  color: var(--c-heading)
  font-family: var(--font-display)
  font-size: 1.32rem
  line-height: 1.35
  font-weight: 500
  letter-spacing: -.01em

.account-signin-dialog .dialog--signin__side p
  margin: 0 0 16px
  font-size: .89rem
  line-height: 1.7

.account-signin-dialog .dialog--signin__main
  position: static
  flex: 0 0 rem($signin_form_width)
  width: auto
  margin: 0
  padding: rem(30px 32px 32px)
  background: var(--c-surface)
  box-shadow: none
  z-index: auto

.account-signin-dialog .dialog--signin__main:only-child
  flex: 1 1 auto

.account-signin-dialog .dialog--signin__title
  margin: 0 0 4px
  text-align: left
  color: var(--c-heading)
  font-family: var(--font-display)
  font-size: 1.6rem
  line-height: 1.3
  font-weight: 500
  letter-spacing: -.02em

.account-signin-dialog .dialog--signin__note
  margin: 0 0 20px
  text-align: left
  color: var(--c-fg-3)
  font-size: .87rem

// 关闭按钮贴在卡片右上角：一个 32px 的图标按钮，不用文字占位
.account-signin-dialog .dialog__close
  display: inline-flex
  align-items: center
  justify-content: center
  position: absolute
  z-index: 3
  top: rem(10px)
  right: rem(10px)
  width: rem(32px)
  height: rem(32px)
  border-radius: 50%
  border: 1px solid var(--c-border)
  background: var(--c-surface)
  color: var(--c-fg-3)
  font-size: rem(15px)
  line-height: 1
  transition: background-color .18s ease-out-cubic, color .18s ease-out-cubic

.account-signin-dialog .dialog__close:hover
  background: var(--c-hover)
  border-color: token-alpha(var(--c-fg), 20%)
  color: var(--c-fg)
  text-decoration: none

.account-signin-dialog .dialog__close:focus-visible
  outline: 2px solid var(--c-accent)
  outline-offset: 2px

// 验证码：一张图 + 一个输入框，右侧“换一张”
.login-captcha
  display: flex
  align-items: flex-end
  gap: 12px
  margin-bottom: 14px

.login-captcha__field
  flex: 1 1 auto
  min-width: 0
  margin-bottom: 0 !important

.login-captcha__figure
  display: flex
  flex-direction: column
  align-items: center
  gap: 3px

.login-captcha__image
  display: block
  width: 132px
  height: 44px
  border-radius: var(--r-sm)
  border: 1px solid var(--c-border)

.login-captcha__refresh
  font-size: .74rem
  color: var(--c-fg-3)

.login-captcha__refresh:hover
  color: var(--c-link)

.account-signin-dialog label.material,
.account-signin-dialog label.textbox
  display: block
  color: var(--c-fg-2)
  font-size: .86rem
  font-weight: 550
  margin-bottom: 14px

.account-signin-dialog label.material input:not([type="checkbox"]),
.account-signin-dialog label.textbox input:not([type="checkbox"])
  display: block
  width: 100%
  box-sizing: border-box
  min-height: 42px
  margin-top: 6px
  padding: 9px 12px
  border: 1px solid var(--c-border)
  border-radius: var(--r-sm)
  background: var(--c-bg)
  color: var(--c-fg)

.account-signin-dialog label.checkbox
  color: var(--c-fg-2)
  font-size: .86rem

.account-signin-dialog input[type="checkbox"]
  accent-color: var(--c-link)

.account-signin-dialog .button,
.account-signin-dialog input[type="submit"]
  min-height: 42px
  border-radius: var(--r-pill)

.account-signin-dialog .text-center.supplementary
  margin-top: 14px
  color: var(--c-fg-3)
  font-size: .86rem

+below(rupture.mobile-cutoff)
  .account-signin-dialog
    flex-direction: column

  .account-signin-dialog .dialog--signin__bg
    order: 2

  .account-signin-dialog .dialog--signin__side
    padding: rem(22px 24px)

  .account-signin-dialog .dialog--signin__main
    flex: 1 1 auto
    padding: rem(24px 22px 26px)
