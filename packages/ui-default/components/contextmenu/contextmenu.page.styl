// 右键菜单：面板外观来自 components/menu-panel，这里只管“跟着光标弹出来”。
.context-menu
  position: fixed
  z-index: 1000
  min-width: rem(198px)
  max-width: rem(280px)
  opacity: 0
  transform: scale(.97)
  transform-origin: top left
  transition: opacity .13s ease-out-cubic, transform .13s ease-out-cubic
  pointer-events: none
  user-select: none

  &[hidden]
    display: none

  // 容器只用来接住焦点（鼠标打开时），高亮只交给具体菜单项
  &:focus,
  &:focus-visible
    outline: none

  &[data-origin^="bottom"]
    transform-origin: bottom left

  &[data-origin$="right"]
    transform-origin: top right

  &[data-origin="bottom-right"]
    transform-origin: bottom right

.context-menu--open
  opacity: 1
  transform: scale(1)
  pointer-events: auto

.context-menu__group
  display: flex
  flex-direction: column
  gap: 1px
  padding: 2px 0

  &[hidden]
    display: none

  & + .context-menu__group
    border-top: 1px solid token-alpha(var(--c-border), 70%)

// 复制成功的小提示，出现在底部中间，不打断视线
.context-menu__toast
  position: fixed
  z-index: 1001
  left: 50%
  bottom: rem(72px)
  padding: 8px 16px
  border-radius: var(--r-pill)
  background: var(--c-inverse-bg)
  color: var(--c-inverse-fg)
  font-size: .82rem
  letter-spacing: .01em
  box-shadow: var(--shadow-pop)
  transform: translate(-50%, 6px)
  opacity: 0
  transition: opacity .18s ease-out-cubic, transform .18s ease-out-cubic
  pointer-events: none

  &[hidden]
    display: none

.context-menu__toast--show
  opacity: 1
  transform: translate(-50%, 0)

@media (prefers-reduced-motion: reduce)
  .context-menu,
  .context-menu__toast
    transition: none
