.reactions
  display: inline

  .reaction
    white-space: nowrap
    width: auto
    border-radius: var(--r-pill)
    overflow: visible
    font-size: rem($font-size-small)
    display: inline-block
    line-height: rem(22px)
    padding: rem(0 10px)
    vertical-align: middle
    border-radius: var(--r)
    border: 1px solid $supplementary-border-color
    cursor: pointer
    &.active, &:hover
      text-decoration: none
      border-color: $primary-color
      color: var(--c-accent-fg) !important
    &.active
      background-color: token-tint($primary-color, 88%) !important
    &:hover
      background-color: token-tint($primary-color, 72%) !important
    .emoji
      margin-right: rem(5px)

.popover-reaction-item
  &:hover
    background-color: $toolbar-bg-hover