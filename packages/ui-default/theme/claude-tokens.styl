// Claude-inspired visual foundation. Keep shared visual values centralized.
:root
  --claude-page: #faf9f5
  --claude-surface: #fffefa
  --claude-surface-muted: #f3f1eb
  --claude-ink: #292824
  --claude-ink-muted: #77736b
  --claude-line: #e7e3da
  --claude-accent: #c96442
  --claude-accent-hover: #ae5033
  --claude-accent-soft: #f7e9e2
  --claude-focus: rgba(201, 100, 66, .28)
  --claude-radius-sm: 8px
  --claude-radius-md: 12px
  --claude-radius-lg: 18px
  --claude-shadow: 0 8px 24px rgba(55, 43, 30, .045)
  --claude-space-1: 4px
  --claude-space-2: 8px
  --claude-space-3: 12px
  --claude-space-4: 16px
  --claude-space-5: 24px
  --claude-space-6: 32px

.theme--dark
  --claude-page: #191816
  --claude-surface: #24221f
  --claude-surface-muted: #302d29
  --claude-ink: #f1eee8
  --claude-ink-muted: #b7b0a5
  --claude-line: #403b35
  --claude-accent: #e08a68
  --claude-accent-hover: #efa184
  --claude-accent-soft: #422d25
  --claude-focus: rgba(224, 138, 104, .3)
  --claude-shadow: 0 8px 24px rgba(0, 0, 0, .18)
