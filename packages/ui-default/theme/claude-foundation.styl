@import './claude-tokens.styl'

body
  color: var(--claude-ink)
  background: var(--claude-page)
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif
  line-height: 1.6

#panel
  background: var(--claude-page)

.main
  width: 100%
  max-width: 1440px
  box-sizing: border-box
  margin: 0 auto
  padding: 32px 28px 56px

.nav
  position: relative
  z-index: 20
  background: var(--claude-surface)
  border-bottom: 1px solid var(--claude-line)
  box-shadow: none

.nav .row > .columns
  display: flex
  align-items: center
  justify-content: space-between

.nav__list
  display: flex
  align-items: center
  gap: 5px
  margin: 0
  padding: 0

.nav__list-item
  display: flex
  align-items: center
  min-height: rem($nav-item-height)

.nav__logo
  display: block
  max-height: 34px
  max-width: 148px
  object-fit: contain

.nav .nav__item
  display: inline-flex
  align-items: center
  min-height: 64px
  padding: 0 13px
  color: var(--claude-ink-muted)
  border-bottom: 2px solid transparent
  background: transparent
  font-weight: 500
  transition: color .16s ease, border-color .16s ease

.nav .nav__item:hover
  color: var(--claude-accent)
  background: transparent
  text-decoration: none

.nav .nav__item.nav--active
  color: var(--claude-accent)
  border-bottom-color: var(--claude-accent)

.nav .nav__item--round
  border-radius: var(--claude-radius-sm)
  background: var(--claude-accent)
  color: #fff
  padding: 9px 15px

.nav .nav__item--round:hover
  background: var(--claude-accent-hover)
  color: #fff

.header--mobile
  background: var(--claude-surface)
  border-bottom: 1px solid var(--claude-line)

.header--mobile__domain img
  max-height: 32px
  max-width: 150px

.section
  background: var(--claude-surface)
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-lg)
  box-shadow: var(--claude-shadow)

.section__header
  padding: 18px 22px
  border-bottom: 1px solid var(--claude-line)

.section__title
  color: var(--claude-ink)
  font-size: 1.05rem
  font-weight: 600

.section__body
  padding: 20px 22px

.section__body.no-padding
  padding: 0

a, .link, a:visited, .link:visited
  color: var(--claude-accent)

a:hover, .link:hover
  color: var(--claude-accent-hover)

button, .button
  border-radius: var(--claude-radius-sm)

.button.primary, button.primary, .button.primary:visited
  background: var(--claude-accent)
  border-color: var(--claude-accent)
  color: #fff

.button.primary:hover, button.primary:hover
  background: var(--claude-accent-hover)
  border-color: var(--claude-accent-hover)
  color: #fff

input:not([type=checkbox]):not([type=radio]), select, textarea, .textbox
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-surface)
  color: var(--claude-ink)

input:focus, select:focus, textarea:focus, button:focus-visible, a:focus-visible
  outline: 3px solid var(--claude-focus)
  outline-offset: 2px

.data-table
  border-collapse: separate
  border-spacing: 0
  color: var(--claude-ink)

.data-table thead
  background: var(--claude-surface-muted)

.data-table thead th
  padding: 14px 12px
  color: var(--claude-ink-muted)
  font-size: .82rem
  font-weight: 600
  border-bottom: 1px solid var(--claude-line)

.data-table tbody tr
  background: var(--claude-surface)
  border-color: var(--claude-line)

.data-table tbody tr:hover
  background: var(--claude-surface-muted)

.data-table tbody td
  padding: 13px 12px
  border-bottom: 1px solid var(--claude-line)

.pager
  display: flex
  flex-wrap: wrap
  gap: 6px
  padding: 14px 18px

.pager__item
  min-width: 34px
  min-height: 34px
  display: inline-flex
  align-items: center
  justify-content: center
  padding: 5px 10px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  color: var(--claude-ink-muted)
  background: var(--claude-surface)

.pager__item.current
  color: var(--claude-accent)
  border-color: transparent
  background: transparent
  font-weight: 600

.pager-bottom .pager__item.current
  border-top: 2px solid var(--claude-accent)

.pager-top .pager__item.current
  border-bottom: 2px solid var(--claude-accent)

.pager__item:hover
  color: var(--claude-accent)
  border-color: var(--claude-accent)
  text-decoration: none

.problem-catalog
  display: grid
  grid-template-columns: minmax(0, 1fr) 280px
  gap: 24px
  align-items: start

.problem-catalog__main
  min-width: 0

.problem-catalog__heading
  margin: 0
  padding: 4px 0 18px
  color: var(--claude-ink)
  font-size: 1.8rem
  font-weight: 600
  letter-spacing: -.025em

.problem-catalog__search
  padding: 18px 20px
  border-bottom: 1px solid var(--claude-line)

.problem-catalog__search .search
  display: flex
  align-items: center
  gap: 8px

.problem-catalog__search .search > input
  min-width: 0
  height: 44px
  padding: 0 14px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-page)
  color: var(--claude-ink)

.problem-catalog__search .search > button
  position: static
  flex: 0 0 44px
  width: 44px
  height: 44px
  border: 0
  border-radius: var(--claude-radius-sm)
  background: var(--claude-accent)
  color: #fff

.problem-catalog__search .search > button:hover
  background: var(--claude-accent-hover)

.problem-catalog__search .search > div
  position: static
  flex: 0 0 auto
  color: var(--claude-ink-muted)
  font-size: .85rem

.problem-catalog__search .search-sort
  position: static
  flex: 0 0 126px
  width: 126px
  height: 44px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-surface)
  color: var(--claude-ink)

.problem-catalog__sidebar .section
  margin-bottom: 18px

.problem-catalog__sidebar .menu__link
  border-radius: var(--claude-radius-sm)

.footer
  margin-top: 28px
  background: var(--claude-surface)
  border-top: 1px solid var(--claude-line)
  color: var(--claude-ink-muted)

.footer a
  color: var(--claude-ink-muted)

.footer a:hover
  color: var(--claude-accent)

@media only screen and (max-width: 900px)
  .main
    padding: 24px 18px 40px
  .problem-catalog
    grid-template-columns: minmax(0, 1fr)
  .problem-catalog__sidebar
    order: 2

@media only screen and (max-width: 600px)
  .main
    padding: 18px 12px 32px
  .problem-catalog__heading
    font-size: 1.5rem
  .problem-catalog__search
    padding: 14px
  .problem-catalog__search .search
    flex-wrap: wrap
  .problem-catalog__search .search > input
    flex: 1 1 100%
  .problem-catalog__search .search-sort
    flex: 1 1 110px
  .section
    border-radius: var(--claude-radius-md)

.theme--dark
  .section
    background: var(--claude-surface)
    border-color: var(--claude-line)
  .data-table thead
    background: var(--claude-surface-muted)
  .data-table tbody tr
    background: var(--claude-surface)
  .data-table tbody tr:hover
    background: var(--claude-surface-muted)
  .problem-catalog__search .search > input
    background: var(--claude-surface)

.problem-catalog__table
  width: 100%

.problem-catalog__table .data-table
  width: 100%

.problem-catalog__table .col--name
  min-width: 220px

.problem-catalog__table .col--problem-name a
  color: var(--claude-ink)
  font-weight: 500

.problem-catalog__table .col--problem-name a:hover
  color: var(--claude-accent)

.problem__tag-link, .problem__tag-item
  border-radius: 999px
  border: 1px solid var(--claude-line)
  background: var(--claude-surface-muted)
  color: var(--claude-ink-muted)

.problem__tag-link:hover
  border-color: var(--claude-accent)
  background: var(--claude-accent-soft)
  color: var(--claude-accent)

.problem-catalog__sidebar .section__body
  padding: 16px 18px

.problem-catalog__sidebar .menu
  margin: 0
  padding: 0

.problem-catalog__sidebar .menu__link
  display: block
  padding: 9px 10px
  color: var(--claude-ink-muted)

.problem-catalog__sidebar .menu__link:hover
  color: var(--claude-accent)
  background: var(--claude-accent-soft)

.problem-catalog__search [data-fragment-id="problem_stat"]
  flex: 0 0 auto
  color: var(--claude-ink-muted)
  white-space: nowrap

.problem-catalog__search [data-fragment-id="problem_stat"] p
  margin: 0

.footer
  padding-top: 22px
  padding-bottom: 18px

@media only screen and (max-width: 600px)
  .problem-catalog__table .data-table
    min-width: 640px
