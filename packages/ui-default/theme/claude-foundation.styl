@import './claude-tokens.styl'

body
  color: var(--claude-ink)
  background: var(--claude-page)
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif
  line-height: 1.6

#panel
  background: var(--claude-page)

.main
  width: 100%
  max-width: 1440px
  box-sizing: border-box
  margin: 0 auto
  padding: 4rem 28px 56px

.section
  background: var(--claude-surface)
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-lg)
  box-shadow: var(--claude-shadow)

.section__header
  padding: 18px 22px
  border-bottom: 1px solid var(--claude-line)

.section__title
  color: var(--claude-ink)
  font-size: 1.05rem
  font-weight: 600

.section__body
  padding: 20px 22px

.section__body.no-padding
  padding: 0

a, .link, a:visited, .link:visited
  color: var(--claude-accent)

a:hover, .link:hover
  color: var(--claude-accent-hover)

button, .button
  border-radius: var(--claude-radius-sm)

.button.primary, button.primary, .button.primary:visited
  background: var(--claude-accent)
  border-color: var(--claude-accent)
  color: #fff

.button.primary:hover, button.primary:hover
  background: var(--claude-accent-hover)
  border-color: var(--claude-accent-hover)
  color: #fff

input:not([type=checkbox]):not([type=radio]), select, textarea, .textbox
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-surface)
  color: var(--claude-ink)

input:focus, select:focus, textarea:focus, button:focus-visible, a:focus-visible
  outline: 3px solid var(--claude-focus)
  outline-offset: 2px

.data-table
  border-collapse: separate
  border-spacing: 0
  color: var(--claude-ink)

.data-table thead
  background: var(--claude-surface-muted)

.data-table thead th
  padding: 14px 12px
  color: var(--claude-ink-muted)
  font-size: .82rem
  font-weight: 600
  border-bottom: 1px solid var(--claude-line)

.data-table tbody tr
  background: var(--claude-surface)
  border-color: var(--claude-line)

.data-table tbody tr:hover
  background: var(--claude-surface-muted)

.data-table tbody td
  padding: 13px 12px
  border-bottom: 1px solid var(--claude-line)

.pager
  display: flex
  flex-wrap: wrap
  gap: 6px
  padding: 14px 18px

.pager__item
  min-width: 34px
  min-height: 34px
  display: inline-flex
  align-items: center
  justify-content: center
  padding: 5px 10px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  color: var(--claude-ink-muted)
  background: var(--claude-surface)

.pager__item.current
  color: var(--claude-accent)
  border-color: transparent
  background: transparent
  font-weight: 600

.pager-bottom .pager__item.current
  border-top: 2px solid var(--claude-accent)

.pager-top .pager__item.current
  border-bottom: 2px solid var(--claude-accent)

.pager__item:hover
  color: var(--claude-accent)
  border-color: var(--claude-accent)
  text-decoration: none

.problem-catalog
  display: grid
  grid-template-columns: minmax(0, 1fr) 280px
  gap: 24px
  align-items: start

.problem-catalog__main
  min-width: 0

.problem-catalog__heading
  margin: 0
  padding: 4px 0 18px
  color: var(--claude-ink)
  font-size: 1.8rem
  font-weight: 600
  letter-spacing: -.025em

.problem-catalog__search
  padding: 18px 20px
  border-bottom: 1px solid var(--claude-line)

.problem-catalog__search .search
  display: flex
  align-items: center
  gap: 8px

.problem-catalog__search .search > input
  min-width: 0
  height: 44px
  padding: 0 14px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-page)
  color: var(--claude-ink)

.problem-catalog__search .search > button
  position: static
  flex: 0 0 44px
  width: 44px
  height: 44px
  border: 0
  border-radius: var(--claude-radius-sm)
  background: var(--claude-accent)
  color: #fff

.problem-catalog__search .search > button:hover
  background: var(--claude-accent-hover)

.problem-catalog__search .search > div
  position: static
  flex: 0 0 auto
  color: var(--claude-ink-muted)
  font-size: .85rem

.problem-catalog__search .search-sort
  position: static
  flex: 0 0 126px
  width: 126px
  height: 44px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-sm)
  background: var(--claude-surface)
  color: var(--claude-ink)

.problem-catalog__sidebar .section
  margin-bottom: 18px

.problem-catalog__sidebar .menu__link
  border-radius: var(--claude-radius-sm)

.footer
  margin-top: 28px
  background: var(--claude-surface)
  border-top: 1px solid var(--claude-line)
  color: var(--claude-ink-muted)

.footer a
  color: var(--claude-ink-muted)

.footer a:hover
  color: var(--claude-accent)

@media only screen and (max-width: 900px)
  .main
    padding: 4rem 18px 40px
  .problem-catalog
    grid-template-columns: minmax(0, 1fr)
  .problem-catalog__sidebar
    order: 2

@media only screen and (max-width: 600px)
  .main
    padding: 18px 12px 32px
  .problem-catalog__heading
    font-size: 1.5rem
  .problem-catalog__search
    padding: 14px
  .problem-catalog__search .search
    flex-wrap: wrap
  .problem-catalog__search .search > input
    flex: 1 1 100%
  .problem-catalog__search .search-sort
    flex: 1 1 110px
  .section
    border-radius: var(--claude-radius-md)

.theme--dark
  .section
    background: var(--claude-surface)
    border-color: var(--claude-line)
  .data-table thead
    background: var(--claude-surface-muted)
  .data-table tbody tr
    background: var(--claude-surface)
  .data-table tbody tr:hover
    background: var(--claude-surface-muted)
  .problem-catalog__search .search > input
    background: var(--claude-surface)

.problem-catalog__table
  width: 100%

.problem-catalog__table .data-table
  width: 100%

.problem-catalog__table .data-table .col--difficulty
  width: 120px
  min-width: 120px
  white-space: nowrap

.problem-catalog__table .data-table.hide-problem-tag .problem__tag.notag--hide,
.problem-catalog__table .data-table.hide-problem-tag .notag--hide
  display: none

.problem-catalog__table .data-table.hide-problem-tag .tag--hide
  display: block

.problem-catalog__table .data-table .tag--hide
  display: none

.problem-catalog__table .col--name
  min-width: 220px

.problem-catalog__table .col--problem-name a
  color: var(--claude-ink)
  font-weight: 500

.problem-catalog__table .col--problem-name a:hover
  color: var(--claude-accent)

.problem__tag-link, .problem__tag-item
  border-radius: 999px
  border: 1px solid var(--claude-line)
  background: var(--claude-surface-muted)
  color: var(--claude-ink-muted)

.problem__tag-link:hover
  border-color: var(--claude-accent)
  background: var(--claude-accent-soft)
  color: var(--claude-accent)

.problem-catalog__sidebar .section__body
  padding: 16px 18px

.problem-catalog__sidebar .menu
  margin: 0
  padding: 0

.problem-catalog__sidebar .menu__link
  display: block
  padding: 9px 10px
  color: var(--claude-ink-muted)

.problem-catalog__sidebar .menu__link:hover
  color: var(--claude-accent)
  background: var(--claude-accent-soft)

.problem-catalog__search [data-fragment-id="problem_stat"]
  flex: 0 0 auto
  color: var(--claude-ink-muted)
  white-space: nowrap

.problem-catalog__search [data-fragment-id="problem_stat"] p
  margin: 0

.footer
  padding-top: 22px
  padding-bottom: 18px

@media only screen and (max-width: 600px)
  .problem-catalog__table .data-table
    min-width: 680px

/* Learning hub activity shells, shared across existing contest/training/homework pages. */
.learning-activity-layout::before,
.learning-activity-layout::after
  content: none

.learning-activity-layout
  display: grid
  grid-template-columns: minmax(0, 1fr) 288px
  gap: var(--claude-space-5)
  align-items: start

.learning-activity-layout > .columns
  float: none
  width: auto
  min-width: 0
  padding-left: 0
  padding-right: 0

.learning-activity-main > .section,
.learning-activity-side > .section
  margin-bottom: var(--claude-space-5)

.learning-activity-main .section__header
  padding: 22px 26px

.learning-activity-main .section__title
  font-size: 1.22rem
  line-height: 1.4
  font-weight: 650
  letter-spacing: -.015em

.learning-activity-side .section__header
  padding: 16px 20px

.learning-activity-side .section__title
  font-size: 1rem

.learning-activity-side .menu__link
  display: block
  padding: 11px 18px
  min-height: 42px
  border-radius: var(--claude-radius-sm)
  color: var(--claude-ink-muted)
  font-size: .91rem
  line-height: 1.55

.learning-activity-side .menu__link:hover,
.learning-activity-side .menu__link.active
  background: var(--claude-accent-soft)
  color: var(--claude-accent)

.learning-activity-side dl.horizontal
  display: grid
  grid-template-columns: minmax(85px, 1fr) minmax(0, 1.3fr)
  gap: 9px 12px
  margin: 0
  font-size: .88rem
  line-height: 1.55

.learning-activity-side dl.horizontal dt
  color: var(--claude-ink-muted)

.learning-activity-side dl.horizontal dd
  min-width: 0
  margin: 0
  overflow-wrap: anywhere

.learning-activity-description .section__body
  padding: 28px 30px
  font-size: 1rem
  line-height: 1.85
  overflow-wrap: anywhere

.learning-activity-description .typo h2
  margin: 1.5em 0 .7em
  font-size: 1.3rem
  line-height: 1.4

.learning-activity-description .typo p,
.learning-activity-description .typo li
  line-height: 1.85

.learning-activity-hero .section__header
  padding: 28px 30px 16px

.learning-activity-hero .section__title
  font-size: clamp(1.5rem, 2.2vw, 2rem)
  line-height: 1.3
  letter-spacing: -.025em

.learning-activity-hero .section__body
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px
  padding: 0 30px 26px

.learning-activity-hero .problem__tag-item
  margin: 0
  min-height: 30px
  padding: 5px 10px
  font-size: .82rem

.learning-activity-list-card .section__header
  display: flex
  flex-wrap: wrap
  align-items: center
  justify-content: space-between
  gap: 14px

.learning-activity-list-card .section__tools
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px

.learning-activity-list-card [name="filter-form"]
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px

.learning-activity-list-card [name="filter-form"] input,
.learning-activity-list-card [name="filter-form"] select
  min-height: 40px
  padding: 8px 10px
  border-radius: var(--claude-radius-sm)
  font-size: .9rem

.learning-activity-list-card [name="filter-form"] input
  min-width: 170px
  flex: 1 1 170px

.learning-activity-list-card .section__list
  margin: 0
  padding: 8px 0
  list-style: none

.learning-activity-list-card .section__list__item
  margin: 0
  padding: 21px 26px
  border-bottom: 1px solid var(--claude-line)
  background: var(--claude-surface)
  transition: background .15s ease

.learning-activity-list-card .section__list__item:last-child
  border-bottom: 0

.learning-activity-list-card .section__list__item:hover
  background: var(--claude-surface-muted)

.learning-activity-list-card .media__body
  min-width: 0

.learning-activity-list-card .numbox
  display: flex
  flex-direction: column
  justify-content: center
  width: 68px
  min-height: 70px
  padding: 8px
  border: 1px solid var(--claude-line)
  border-radius: var(--claude-radius-md)
  background: var(--claude-page)
  color: var(--claude-ink)

.learning-activity-list-card .numbox__num
  font-size: 1.5rem
  font-weight: 650
  line-height: 1.3

.learning-activity-list-card .numbox__text
  font-size: .78rem
  color: var(--claude-ink-muted)

.learning-activity-list-card .supplementary.list
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: 7px 16px
  margin: 10px 0 0
  color: var(--claude-ink-muted)
  font-size: .84rem
  line-height: 1.55

.learning-activity-list-card .section__list__item h1
  margin: 0
  color: var(--claude-ink)
  font-size: 1.11rem
  font-weight: 620
  line-height: 1.45

.learning-activity-list-card .section__list__item h1 a
  color: var(--claude-ink)

.learning-activity-list-card .section__list__item h1 a:hover
  color: var(--claude-accent)

.learning-activity-main .data-table
  font-size: .9rem

.learning-activity-main .data-table th
  padding: 14px 12px
  line-height: 1.5

.learning-activity-main .data-table td
  padding: 13px 12px
  line-height: 1.6

.learning-activity-main .col--problem-name a
  font-weight: 570

@media only screen and (max-width: 900px)
  .learning-activity-layout
    grid-template-columns: minmax(0, 1fr)
    gap: var(--claude-space-4)

  .learning-activity-side
    order: 2

@media only screen and (max-width: 600px)
  .learning-activity-main .section__header,
  .learning-activity-description .section__body
    padding: 18px

  .learning-activity-hero .section__header
    padding: 20px 18px 14px

  .learning-activity-hero .section__body
    padding: 0 18px 20px

  .learning-activity-list-card .section__list__item
    padding: 16px

  .learning-activity-list-card .numbox
    width: 55px
    min-height: 62px
