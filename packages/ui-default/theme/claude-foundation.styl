// School / catalog layout.
//
// This started as a parallel "claude-*" styling layer. Everything that
// duplicated a component (nav, buttons, cards, tables, pager, footer) now lives
// next to that component and is driven by --c-* tokens, so only the catalog
// specific layout is left here. Colours must come from the palette.

// The catalog is a bespoke page shell (no .row/.columns), so it carries its own
// page gutters; without them the heading and the sidebar touch the viewport.
.problem-catalog
  display: grid
  grid-template-columns: minmax(0, 1fr) var(--w-sidebar)
  gap: var(--layout-gap)
  align-items: start
  max-width: var(--w-page)
  margin: 0 auto
  padding: 0 var(--layout-gutter)

.problem-catalog__main
  min-width: 0

.problem-catalog__heading
  margin: 0
  padding: 4px 0 18px
  color: var(--c-fg)
  font-size: 1.8rem
  font-weight: 600
  letter-spacing: -.025em

.problem-catalog__search
  padding: 18px 20px
  border-bottom: 1px solid var(--c-border)

.problem-catalog__search .search
  display: flex
  align-items: center
  gap: 8px

.problem-catalog__search .search > input
  min-width: 0
  height: 40px
  padding: 0 13px
  border: 1px solid var(--c-border)
  border-radius: var(--r-sm)
  background: var(--c-bg)
  color: var(--c-fg)

.problem-catalog__search .search > button
  position: static
  flex: 0 0 40px
  width: 40px
  height: 40px
  border: 1px solid var(--c-border)
  border-radius: var(--r-sm)
  background: var(--c-surface)
  color: var(--c-fg-3)

.problem-catalog__search .search > button:hover
  border-color: var(--c-link)
  background: var(--c-accent-soft)
  color: var(--c-link)

.problem-catalog__search .search > div
  position: static
  flex: 0 0 auto
  color: var(--c-fg-3)
  font-size: .85rem

.problem-catalog__search .search-sort
  position: static
  flex: 0 0 126px
  width: 126px
  height: 44px
  border: 1px solid var(--c-border)
  border-radius: var(--r-sm)
  // background-color：简写会清掉 form/select 画的下拉箭头
  background-color: var(--c-surface)
  color: var(--c-fg)
  padding-right: rem(30px)

.problem-catalog__sidebar .section
  margin-bottom: 18px

.problem-catalog__sidebar .menu__link
  border-radius: var(--r-sm)


.problem-catalog__table
  width: 100%

.problem-catalog__table .data-table
  width: 100%

.problem-catalog__table .data-table .col--difficulty
  width: 120px
  min-width: 120px
  white-space: nowrap

.problem-catalog__table .data-table.hide-problem-tag .problem__tag.notag--hide,
.problem-catalog__table .data-table.hide-problem-tag .notag--hide
  display: none

.problem-catalog__table .data-table.hide-problem-tag .tag--hide
  display: block

.problem-catalog__table .data-table .tag--hide
  display: none

.problem-catalog__table .col--name
  min-width: 220px

.problem-catalog__table .col--problem-name a
  color: var(--c-fg)
  font-weight: 500

.problem-catalog__table .col--problem-name a:hover
  color: var(--c-link)

.problem__tag-link, .problem__tag-item
  display: inline-flex
  align-items: center
  gap: 6px
  max-width: 100%
  border-radius: var(--r-pill)
  border: 1px solid var(--c-border)
  background: var(--c-sunken)
  color: var(--c-fg-3)

// inline user links inside a chip (host, owner, author) must not push the row apart
.problem__tag-item .user-profile-link,
.problem__tag-link .user-profile-link
  display: inline-flex
  align-items: center
  gap: 5px
  min-width: 0

.problem__tag-item .user-profile-link img,
.problem__tag-link .user-profile-link img
  width: 16px
  height: 16px
  margin: 0
  border-radius: 50%

.problem__tag-item .user-profile-name,
.problem__tag-link .user-profile-name
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.problem__tag-item sup,
.problem__tag-link sup
  font-size: .68em
  line-height: 1

.problem__tag-link:hover
  border-color: var(--c-link)
  background: var(--c-accent-soft)
  color: var(--c-link)

.problem-catalog__sidebar .section__body
  padding: 16px 18px

.problem-catalog__sidebar .menu
  margin: 0
  padding: 0

.problem-catalog__sidebar .menu__link
  display: block
  padding: 9px 10px
  color: var(--c-fg-3)

.problem-catalog__sidebar .menu__link:hover
  color: var(--c-link)
  background: var(--c-accent-soft)

.problem-catalog__search [data-fragment-id="problem_stat"]
  flex: 0 0 auto
  color: var(--c-fg-3)
  white-space: nowrap

.problem-catalog__search [data-fragment-id="problem_stat"] p
  margin: 0

.footer
  padding-top: 22px
  padding-bottom: 18px

@media only screen and (max-width: 600px)
  .problem-catalog__table .data-table
    min-width: 680px

/* Learning hub activity shells, shared across existing contest/training/homework pages. */
.learning-activity-layout::before,
.learning-activity-layout::after
  content: none

.learning-activity-layout
  display: grid
  grid-template-columns: minmax(0, 1fr) var(--w-sidebar)
  gap: var(--sp-5)
  align-items: start

.learning-activity-layout > .columns
  float: none
  width: auto
  min-width: 0
  padding-left: 0
  padding-right: 0

.learning-activity-main > .section,
.learning-activity-side > .section
  margin-bottom: var(--sp-5)

.learning-activity-main .section__header
  padding: 22px 26px

.learning-activity-main .section__title
  font-size: 1.22rem
  line-height: 1.4
  font-weight: 650
  letter-spacing: -.015em

.learning-activity-side .section__header
  padding: 16px 20px

.learning-activity-side .section__title
  font-size: 1rem

.learning-activity-side .menu__link
  display: block
  padding: 11px 18px
  min-height: 42px
  border-radius: var(--r-sm)
  color: var(--c-fg-2)
  font-size: .91rem
  line-height: 1.55

.learning-activity-side .menu__link:hover,
.learning-activity-side .menu__link.active
  background: var(--c-accent-soft)
  color: var(--c-link)

.learning-activity-side dl.horizontal
  display: grid
  grid-template-columns: minmax(85px, 1fr) minmax(0, 1.3fr)
  gap: 9px 12px
  margin: 0
  font-size: .88rem
  line-height: 1.55

.learning-activity-side dl.horizontal dt
  color: var(--c-fg-2)

.learning-activity-side dl.horizontal dd
  min-width: 0
  margin: 0
  overflow-wrap: anywhere

.learning-activity-description .section__body
  padding: 28px 30px
  font-size: 1rem
  line-height: 1.85
  overflow-wrap: anywhere

.learning-activity-description .typo h2
  margin: 1.5em 0 .7em
  font-size: 1.3rem
  line-height: 1.4

.learning-activity-description .typo p,
.learning-activity-description .typo li
  line-height: 1.85

.learning-activity-hero .section__header
  padding: 28px 30px 16px

.learning-activity-hero .section__title
  font-size: clamp(1.5rem, 2.2vw, 2rem)
  line-height: 1.3
  letter-spacing: -.025em

.learning-activity-hero .section__body
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px
  padding: 0 30px 26px

.learning-activity-hero .problem__tag-item
  margin: 0
  min-height: 30px
  padding: 5px 10px
  font-size: .82rem

.learning-activity-list-card .section__header
  display: flex
  flex-wrap: wrap
  align-items: center
  justify-content: space-between
  gap: 14px

.learning-activity-list-card .section__tools
  // misc/section.styl 把它绝对定位在标题右侧；表头本身已经是 flex，
  // 这里回到文档流，窄屏下筛选栏换行时表头才能跟着长高（否则压住第一行）
  position: static
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px

.learning-activity-list-card [name="filter-form"]
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px

.learning-activity-list-card [name="filter-form"] input,
.learning-activity-list-card [name="filter-form"] select
  min-height: 40px
  padding: 8px 10px
  border-radius: var(--r-sm)
  font-size: .9rem

.learning-activity-list-card [name="filter-form"] input
  min-width: 170px
  flex: 1 1 170px

// 下拉要留出箭头的宽度
.learning-activity-list-card [name="filter-form"] select
  padding-right: rem(30px)

.learning-activity-list-card .section__list
  margin: 0
  padding: 8px 0
  list-style: none

.learning-activity-list-card .section__list__item
  margin: 0
  padding: 21px 26px
  border-bottom: 1px solid var(--c-border)
  background: var(--c-surface)
  transition: background .15s ease

.learning-activity-list-card .section__list__item:last-child
  border-bottom: 0

.learning-activity-list-card .section__list__item:hover
  background: var(--c-sunken)

.learning-activity-list-card .media__body
  min-width: 0

.learning-activity-list-card .numbox
  display: flex
  flex-direction: column
  justify-content: center
  width: 68px
  min-height: 70px
  padding: 8px
  border: 1px solid var(--c-border)
  border-radius: var(--r)
  background: var(--c-bg)
  color: var(--c-fg)

.learning-activity-list-card .numbox__num
  font-size: 1.5rem
  font-weight: 650
  line-height: 1.3

.learning-activity-list-card .numbox__text
  font-size: .78rem
  color: var(--c-fg-2)

.learning-activity-list-card .supplementary.list
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: 7px 16px
  margin: 10px 0 0
  color: var(--c-fg-2)
  font-size: .84rem
  line-height: 1.55

.learning-activity-list-card .section__list__item h1
  margin: 0
  color: var(--c-fg)
  font-size: 1.11rem
  font-weight: 620
  line-height: 1.45

.learning-activity-list-card .section__list__item h1 a
  color: var(--c-fg)

.learning-activity-list-card .section__list__item h1 a:hover
  color: var(--c-link)

.learning-activity-main .data-table
  font-size: .9rem

.learning-activity-main .data-table th
  padding: 14px 12px
  line-height: 1.5

.learning-activity-main .data-table td
  padding: 13px 12px
  line-height: 1.6

.learning-activity-main .col--problem-name a
  font-weight: 570

@media only screen and (max-width: 900px)
  .learning-activity-layout
    grid-template-columns: minmax(0, 1fr)
    gap: var(--sp-4)

  .learning-activity-side
    order: 2

@media only screen and (max-width: 600px)
  .learning-activity-main .section__header,
  .learning-activity-description .section__body
    padding: 18px

  .learning-activity-hero .section__header
    padding: 20px 18px 14px

  .learning-activity-hero .section__body
    padding: 0 18px 20px

  .learning-activity-list-card .section__list__item
    padding: 16px

  .learning-activity-list-card .numbox
    width: 55px
    min-height: 62px

// Nets inside a narrow rail cannot hold a 37%/62% horizontal definition list:
// labels were clipped to a single glyph. Stack them instead.
+above(rupture.desktop-cutoff)
  .section.side dl.horizontal
    dt,
    dd
      float: none
      width: auto
      overflow: visible
      white-space: normal
      text-overflow: clip

    dt
      margin: 12px 0 2px
      color: var(--c-fg-3)
      font-size: .76rem
      font-weight: 550
      letter-spacing: .04em

    dd
      margin: 0 0 12px
      color: var(--c-fg)
      line-height: 1.6

    dt:first-child
      margin-top: 2px

// ---------------------------------------------------------------------------
// Activity lists (homework / contest / training)
//
// One row pattern for every "list of activities" card: quiet two-line date,
// sans-serif title as the focal point, label/value meta on one line, hover on
// the row instead of a bordered card per item. The container already carries
// the surface; rows are separated by hairlines only.
// ---------------------------------------------------------------------------
.activity-item
  position: relative
  margin: 0
  padding: 14px 20px
  border-bottom: 1px solid var(--c-border)
  transition: background-color .14s ease

  &:last-child
    border-bottom: 0

  &:hover
    background: var(--c-hover)

  // a closing deadline gets a hairline marker, not a colour block
  &--closing::before
    content: ''
    position: absolute
    top: 0
    bottom: 0
    left: 0
    width: 2px
    background: var(--c-warn)

.activity__date
  display: flex
  flex-direction: column
  gap: 1px
  width: 56px
  margin-right: 16px
  color: var(--c-fg-3)
  font-variant-numeric: tabular-nums
  line-height: 1.25

.activity__date-day
  color: var(--c-fg-2)
  font-size: 1.02rem
  font-weight: 600

.activity__date-month
  font-size: .72rem

// content titles are sans-serif; the serif stays for page and section titles
.activity__title
  margin: 0 0 4px
  font-family: var(--font-ui)
  font-size: .97rem
  font-weight: 600
  line-height: 1.5
  letter-spacing: 0

.activity__title a
  color: var(--c-fg)
  text-decoration: none

  // whole row is clickable, the date column stays selectable
  &::after
    content: ''
    position: absolute
    top: 0
    right: 0
    bottom: 0
    left: 92px

  &:hover
    color: var(--c-link)
    text-decoration: underline
    text-underline-offset: 2px

.activity__meta
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 2px 16px
  margin: 0
  font-size: .82rem
  line-height: 1.6

.activity__meta .activity__meta-item
  display: inline-flex
  align-items: center
  gap: 5px
  margin: 0

.activity__meta .activity__meta-item .icon
  color: var(--c-fg-3)
  font-size: .95em

.activity__meta .activity__meta-item--times
  margin-left: auto

.activity__meta-label
  color: var(--c-fg-3)

.activity__meta-value
  color: var(--c-fg-2)

.activity__meta-sep
  color: var(--c-border-strong)

// status: one semantic dot instead of a filled chip
.activity__meta-item--status .activity__meta-value
  display: inline-flex
  align-items: center
  gap: 6px
  color: var(--c-fg)
  font-weight: 500

  &::before
    content: ''
    width: 6px
    height: 6px
    border-radius: var(--r-pill)
    background: var(--c-info)

.activity-item--live .activity__meta-item--status .activity__meta-value::before
  background: var(--c-ok)

.activity-item--done .activity__meta-item--status .activity__meta-value
  color: var(--c-fg-3)
  font-weight: 400

  &::before
    background: var(--c-fg-3)

.activity-item--closing .activity__meta-item--status .activity__meta-value
  color: var(--c-warn)

  &::before
    background: var(--c-warn)

.activity__metadata-attended,
.contest__info-attended
  color: var(--c-ok)

@media only screen and (max-width: 600px)
  .activity-item
    padding: 13px 16px

  .activity__date
    width: 44px
    margin-right: 12px

  .activity__title a::after
    left: 76px

  // 窄屏换行后时间不再靠右，避免和状态各占一行时左右跳
  .activity__meta .activity__meta-item--times
    margin-left: 0
