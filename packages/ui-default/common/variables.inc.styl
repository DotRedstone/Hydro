// Stylus variables used by components.
// Every color/shape/font here points at a design token (CSS custom property)
// defined by the active palette in theme/palettes/*.css. Do NOT put literal
// colors in this file or in any component: add a token instead (theme/README.md).

// layout
$grid-padding = 15px // half gutter

// fonts
$primary-font-family = var(--font-family)
$header-font-family = var(--font-display)
$code-font-family = var(--code-font-family)

// primary palette
$default-color = var(--c-border-strong)
$primary-color = var(--c-accent)
$secondary-color = var(--c-accent)
$highlight-color = var(--c-accent)
$code-color = var(--c-code-fg)
$text-1-color = var(--c-fg)
$text-2-color = var(--c-fg-2)
$text-3-color = var(--c-fg-3)
$header-1-color = var(--c-heading)
$header-2-color = var(--c-heading)
$blockquote-color = var(--c-fg-2)
$page-bg-color = var(--c-bg)
$content-bg-color = var(--c-surface)
$border-1-color = var(--c-border-strong)
$border-2-color = var(--c-border)

$immersive-primary-color = var(--c-accent)
$immersive-text-color = var(--c-fg)
$immersive-header-color = var(--c-heading)

$success-color = var(--c-ok)
$fail-color = var(--c-bad)
$progress-color = var(--c-warn)
$invalid-color = var(--c-neutral)

// sizes
$font-size = 15px             // main content
$font-size-secondary = 14px   // secondary content
$font-size-small = 13px       // additional informations, usually gray colored
$font-size-icon = 16px
$font-size-title = 20px

// shape
$radius-sm = var(--r-sm)
$radius = var(--r)
$radius-lg = var(--r-lg)
$radius-pill = var(--r-pill)

// components
$section-gap-v = 20px
$section-gap-h = 20px
$section-list-v = 20px
$section-margin = 24px
$section-shadow = var(--shadow-card)
$section-bg-color = var(--c-surface)
$section-title-color = var(--c-heading)
$section-toolbtn-color = var(--c-fg-3)
$section-toolbtn-color-hover = var(--c-fg)

$autocomplete-empty-row-color = var(--c-fg-3)
$userselect-uid-color = var(--c-fg-3)

$editor-border-color = var(--c-border-strong)

$datepicker-shadow = var(--shadow-pop)
$datapicker-list-item-bg-color-hover = var(--c-hover)

$dialog-layer-bg-color = var(--c-overlay)
$dialog-bg-color = var(--c-surface)
$dialog-border-color = var(--c-border)
$dialog-shadow = var(--shadow-pop)
$dialog-title-color = var(--c-heading)

$comment-placeholder-color = var(--c-fg-3)
$comment-op-color = var(--c-fg-3)
$comment-op-link-color = var(--c-fg-3)

$menu-item-bg-color-hover = var(--c-hover)
$menu-drop-shadow = var(--shadow-pop)
$menu-drop-bg-color = var(--c-surface)
$menu-drop-triangle-size = 0px
$menu-drop-triangle-shadow = none

$nav-item-height = 56px
$nav-item-hover-color = var(--c-fg)
$nav-item-active-color = var(--c-fg)
$nav-item-active-immersive-color = var(--c-fg)
$nav-item-round-height = 34px
$nav-item-round-color = var(--c-accent)
$nav-item-round-border = 1px
$nav-logo-height = 28px
$nav-logo-height-mobile = 23px

$header-layer-height = 100px
$header-bg-width = 1920px
$header-bg-height = 320px
$header-bg-height-mini = $header-bg-height - $header-layer-height
$header-logo-width = 252px
$header-logo-height = 150px
$header-logo-width-real = 381px
$header-logo-height-real = 201px
$header-logo-domain-lh = 60px
$header-logo-system-lh = 30px

$footer-bg-color = var(--c-bg)

$input-focus-color = var(--c-focus-ring)
$form-control-height = 36px
$compact-control-height = 30px
$input-margin = 0 0 1rem
$input-multi-line-margin = 0 0.3rem 0.15rem 0
$input-image-radio-margin = 0 0.3rem 0.3rem 0
$input-background-color = var(--c-surface)
$input-border = 1px solid var(--c-border-strong)
$input-outline = 2px solid transparent
$input-focus-border-color = var(--c-accent)
$input-focus-outline = 3px solid var(--c-focus-ring)
$label-color = var(--c-fg-2)
$help-text-color = var(--c-fg-3)

$table-row-hover-bg-color = var(--c-hover)
$table-border-color = var(--c-border)
$table-alternate-bg-color = transparent
$table-header-bg-color = var(--c-surface)
$table-header-shadow = none
$table-header-shadow-floating = 0 1px 0 var(--c-border)
$table-padding-h = 12px
$table-lh = 26px

$toolbar-bg = var(--c-sunken)
$toolbar-fore = var(--c-fg-3)
$toolbar-fore-hover = var(--c-fg)
$toolbar-bg-hover = var(--c-hover)
$toolbar-fore-selected = var(--c-accent-fg)
$toolbar-bg-selected = var(--c-accent)
$toolbar-disabled-opacity = 0.3

$supplementary-color = var(--c-fg-3)
$supplementary-border-color = var(--c-border)
$supplementary-link-color = var(--c-fg-2)

$pager-border-color = var(--c-border)

$nprogress-color = var(--c-accent)

$syntax-hl-bg-color = var(--c-code-bg)

// Calendar
$calendar-banner-color = {
  '0': var(--c-cat-1),
  '1': var(--c-cat-7),
  '2': var(--c-cat-2),
  '3': var(--c-cat-3),
  '4': var(--c-cat-4),
  '5': var(--c-cat-5),
  '6': var(--c-cat-4),
  '7': var(--c-cat-5),
  '8': var(--c-cat-6),
  '9': var(--c-cat-6),
  '10': var(--c-cat-8),
  '11': var(--c-cat-8),
}

// Notification
$notification-color = {
  'success': var(--c-ok),
  'info': var(--c-info),
  'warn': var(--c-warn),
  'error': var(--c-bad),
}

$notification-icon = {
  'success': $icon-check--circle,
  'info': $icon-info--circle,
  'warn': $icon-info--circle,
  'error': $icon-close--circle,
}

// Badge
$badge-text-color = {
  'mod': var(--c-accent-fg),
  'su': var(--c-accent-fg),
  'lv0': var(--c-fg-2),
  'lv1': var(--c-surface),
  'lv2': var(--c-surface),
  'lv3': var(--c-surface),
  'lv4': var(--c-surface),
  'lv5': var(--c-surface),
  'lv6': var(--c-surface),
  'lv7': var(--c-surface),
  'lv8': var(--c-surface),
  'lv9': var(--c-surface),
  'lv10': var(--c-surface),
}
$badge-bg-color = {
  'mod': var(--c-cat-6),
  'su': var(--c-bad),
  'lv0': var(--c-neutral-soft),
  'lv1': var(--c-cat-8),
  'lv2': var(--c-cat-8),
  'lv3': var(--c-cat-4),
  'lv4': var(--c-cat-4),
  'lv5': var(--c-cat-3),
  'lv6': var(--c-cat-3),
  'lv7': var(--c-cat-2),
  'lv8': var(--c-cat-1),
  'lv9': var(--c-bad),
  'lv10': var(--c-heading),
}

// Record Status
$record-status-color = {
  'pass': $success-color,
  'fail': $fail-color,
  'progress': $progress-color,
  'ignored': $invalid-color,
  'pending': $invalid-color,
}

$record-status-icon = {
  'pass': $icon-check,
  'fail': $icon-close,
  'progress': $icon-hourglass,
  'ignored': $icon-close,
  'pending': $icon-schedule,
}

// Training Status
$training-status-color = {
  'outside': $supplementary-color,
  'progress': var(--c-accent),
  'done': var(--c-ok),
}

$training-status-icon = {
  'outside': $icon-help2,
  'progress': $icon-schedule,
  'done': $icon-check,
}

// Training Section Status
$training-section-status-color = {
  'done': var(--c-ok),
  'open': var(--c-accent),
  'progress': var(--c-accent),
  'invalid': $supplementary-color,
}

$training-section-status-icon = {
  'done': $icon-check,
  'open': $icon-help2,
  'progress': $icon-schedule,
  'invalid': $icon-close,
}

// Contest type
$contest-color = {
  'acm': var(--c-cat-3),
  'oi': var(--c-cat-2),
  'ioi': var(--c-cat-5),
  'ledo': var(--c-cat-6),
  'homework': var(--c-cat-7),
  'strictioi': var(--c-cat-4),
}
